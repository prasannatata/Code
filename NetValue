public with sharing class Order_GetByDateRangeAction {

    // === Input DTO ===
    public class Request {
        @InvocableVariable(label='Start Date')
        public Date startDate;

        @InvocableVariable(label='End Date')
        public Date endDate;
    }

    // === Output DTO ===
    public class Response {
        @InvocableVariable(label='Result')
        public String result;
    }

    // === Invocable Method ===
    @InvocableMethod(label='Get Orders By Date Range')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();

        for (Request r : reqs) {
            Response res = new Response();

            // Validate inputs
            if (r.startDate == null || r.endDate == null) {
                res.result = '⚠️ Please provide both Start Date and End Date.';
            } else if (r.startDate > r.endDate) {
                res.result = '⚠️ Start Date cannot be after End Date.';
            } else {
                try {
                    // Query orders between given dates
                    List<Realistic_OrderLine_Datacsv__dlm> rows = [
                        SELECT OrderRefNumber__c,
                               CustomerID__c,
                               CustomerName__c,
                               ParentCustomerID__c,
                               ParentCustomerName__c,
                               OrderStatus__c,
                               OrderCreateDate__c,
                               OrderPODate__c,
                               Modality__c,
                               Vendor__c,
                               OEM__c,                  // 👈 now included
                               PartNumber__c,
                               PartDescription__c,
                               Quantity__c,
                               Revenue__c,
                               Requestor__c,
                               SalesRep__c
                        FROM Realistic_OrderLine_Datacsv__dlm
                        WHERE OrderCreateDate__c >= :r.startDate
                          AND OrderCreateDate__c <= :r.endDate
                        ORDER BY OrderCreateDate__c ASC
                    ];

                    if (rows.isEmpty()) {
                        res.result = '❌ No orders found between ' +
                                     String.valueOf(r.startDate) + ' and ' +
                                     String.valueOf(r.endDate) + '.';
                    } else {
                        res.result = OrderDL_Util.fmtOrdersTable(
                            rows,
                            'Orders from ' + String.valueOf(r.startDate) +
                            ' to ' + String.valueOf(r.endDate)
                        );
                    }
                } catch (Exception e) {
                    res.result = '⚠️ An error occurred while fetching orders: ' + e.getMessage();
                }
            }

            results.add(res);
        }

        return results;
    }
}
