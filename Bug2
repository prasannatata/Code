public with sharing class Order_GetDetailsAction {
    
    public class Request {
        @InvocableVariable(required=true label='Order Reference Number')
        public String orderRef;
    }
    
    public class Response {
        @InvocableVariable(label='Order Details')
        public String result;
    }
    
    @InvocableMethod(label='Get Order Details' description='Retrieve complete details for a specific order')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();
        
        for (Request r : reqs) {
            Response res = new Response();
            
            try {
                List<Realistic_OrderLine_Datacsv__dlm> rows = [
                    SELECT OrderRefNumber__c, CustomerName__c, CustomerID__c,
                           ParentCustomerName__c, ParentCustomerID__c,
                           OrderStatus__c, OrderCreateDate__c, OrderPODate__c,
                           Vendor__c, Modality__c, OEM__c,
                           PartNumber__c, PartDescription__c,
                           Quantity__c, Revenue__c,
                           Requestor__c, SalesRep__c
                    FROM Realistic_OrderLine_Datacsv__dlm
                    WHERE OrderRefNumber__c = :r.orderRef
                    LIMIT 1
                ];
                
                if (rows.isEmpty()) {
                    res.result = '❌ No order found with reference: ' + r.orderRef;
                } else {
                    res.result = formatOrderCard(rows[0]);
                }
                
            } catch (Exception e) {
                res.result = '⚠️ Error while fetching order ' + r.orderRef + ': ' + e.getMessage();
            }
            
            results.add(res);
        }
        
        return results;
    }
    
    // Format order details into a nice card layout
    private static String formatOrderCard(Realistic_OrderLine_Datacsv__dlm order) {
        String output = '';
        
        // Header
        output += '📋 **Order Details**' + '\n';
        output += '═══════════════════════════════════════' + '\n' + '\n';
        
        // Order Information
        output += '🔹 **Order Reference:** ' + (order.OrderRefNumber__c != null ? order.OrderRefNumber__c : 'N/A') + '\n';
        output += '🔹 **Status:** ' + (order.OrderStatus__c != null ? order.OrderStatus__c : 'N/A') + '\n';
        output += '🔹 **Created Date:** ' + (order.OrderCreateDate__c != null ? order.OrderCreateDate__c.format() : 'N/A') + '\n';
        output += '🔹 **PO Date:** ' + (order.OrderPODate__c != null ? order.OrderPODate__c.format() : 'N/A') + '\n' + '\n';
        
        // Customer Information
        output += '👥 **Customer Information**' + '\n';
        output += '───────────────────────────────────────' + '\n';
        output += '   • **Customer:** ' + (order.CustomerName__c != null ? order.CustomerName__c : 'N/A') + '\n';
        output += '   • **Customer ID:** ' + (order.CustomerID__c != null ? order.CustomerID__c : 'N/A') + '\n';
        
        if (order.ParentCustomerName__c != null) {
            output += '   • **Parent Customer:** ' + order.ParentCustomerName__c + '\n';
            if (order.ParentCustomerID__c != null) {
                output += '   • **Parent Customer ID:** ' + order.ParentCustomerID__c + '\n';
            }
        }
        output += '\n';
        
        // Product Information
        output += '📦 **Product Information**' + '\n';
        output += '───────────────────────────────────────' + '\n';
        output += '   • **Vendor:** ' + (order.Vendor__c != null ? order.Vendor__c : 'N/A') + '\n';
        output += '   • **OEM:** ' + (order.OEM__c != null ? order.OEM__c : 'N/A') + '\n';
        output += '   • **Modality:** ' + (order.Modality__c != null ? order.Modality__c : 'N/A') + '\n';
        output += '   • **Part Number:** ' + (order.PartNumber__c != null ? order.PartNumber__c : 'N/A') + '\n';
        
        if (order.PartDescription__c != null) {
            output += '   • **Description:** ' + order.PartDescription__c + '\n';
        }
        
        output += '   • **Quantity:** ' + (order.Quantity__c != null ? String.valueOf(order.Quantity__c.setScale(0)) : 'N/A') + '\n';
        output += '   • **Revenue:** ' + (order.Revenue__c != null ? '$' + order.Revenue__c.setScale(2).format() : 'N/A') + '\n' + '\n';
        
        // People Information
        output += '👤 **Team Information**' + '\n';
        output += '───────────────────────────────────────' + '\n';
        output += '   • **Requestor:** ' + (order.Requestor__c != null ? order.Requestor__c : 'N/A') + '\n';
        output += '   • **Sales Rep:** ' + (order.SalesRep__c != null ? order.SalesRep__c : 'N/A') + '\n';
        
        return output;
    }
}

