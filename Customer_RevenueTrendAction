public class Customer_RevenueTrendAction {
    public class Request {
        @InvocableVariable(required=true)
        public String customerName;
    }

    public class Response {
        @InvocableVariable
        public String result;
    }

    @InvocableMethod
    public static List<Response> run(List<Request> requests) {
        List<Response> results = new List<Response>();

        for (Request r : requests) {
            String query = OrderDL_Util.buildBaseQuery() +
                           'WHERE CustomerName__c = :r.customerName';

            List<Realistic_OrderLine_Datacsv__dlm> rows = Database.query(query);

            Response res = new Response();
            if (rows.isEmpty()) {
                res.result = '❌ No orders found for customer ' + r.customerName;
            } else {
                Decimal totalRevenue = 0;
                for (Realistic_OrderLine_Datacsv__dlm row : rows) {
                    totalRevenue += row.Revenue__c;
                }
                res.result = '📊 Revenue trend for **' + r.customerName + '**\n' +
                             '- Total Orders: ' + rows.size() + '\n' +
                             '- Total Revenue: $' + totalRevenue + '\n\n' +
                             OrderDL_Util.fmtOrdersTable(rows, 'Revenue Details');
            }
            results.add(res);
        }
        return results;
    }
}
