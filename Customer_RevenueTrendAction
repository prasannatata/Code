public with sharing class Customer_RevenueTrendAction {
    public class Request { @InvocableVariable public String customerName; }
    public class Response { @InvocableVariable public String result; }

    @InvocableMethod
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();
        for (Request r : reqs) {
            Response res = new Response();

            String query = 'SELECT ' + OrderDL_Util.BASE_FIELDS +
                           ' FROM Realistic_OrderLine_Datacsv__dlm ' +
                           'WHERE CustomerName__c = :r.customerName';

            List<Realistic_OrderLine_Datacsv__dlm> rows = Database.query(query);

            if (rows.isEmpty()) res.result = '❌ No orders found for ' + r.customerName;
            else res.result = OrderDL_Util.fmtOrdersTable(rows, 'Revenue Trend for ' + r.customerName);

            results.add(res);
        }
        return results;
    }
}
