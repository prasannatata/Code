public with sharing class Order_GetByCustomerAction {

    public class Request {
        @InvocableVariable(label='Customer Filter (Optional)')
        public String customerName;

        @InvocableVariable(label='Parent Customer Filter (Optional)')
        public String parentCustomerName;
    }

    public class Response {
        @InvocableVariable(label='Result')
        public String result;
    }

    @InvocableMethod(label='Get Orders By Customer')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();

        for (Request r : reqs) {
            Response res = new Response();
            List<Realistic_OrderLine_Datacsv__dlm> rows;

            // Apply filter if customer or parent customer specified
            if (String.isNotBlank(r.customerName)) {
                rows = [
                    SELECT CustomerName__c, ParentCustomerName__c, Quantity__c, Revenue__c
                    FROM Realistic_OrderLine_Datacsv__dlm
                    WHERE CustomerName__c = :r.customerName
                ];
            } else if (String.isNotBlank(r.parentCustomerName)) {
                rows = [
                    SELECT CustomerName__c, ParentCustomerName__c, Quantity__c, Revenue__c
                    FROM Realistic_OrderLine_Datacsv__dlm
                    WHERE ParentCustomerName__c = :r.parentCustomerName
                ];
            } else {
                rows = [
                    SELECT CustomerName__c, ParentCustomerName__c, Quantity__c, Revenue__c
                    FROM Realistic_OrderLine_Datacsv__dlm
                ];
            }

            if (rows.isEmpty()) {
                res.result = (String.isNotBlank(r.customerName))
                    ? '❌ No orders found for customer ' + r.customerName
                    : (String.isNotBlank(r.parentCustomerName))
                        ? '❌ No orders found for parent customer ' + r.parentCustomerName
                        : '❌ No customer data found.';
            } else {
                // Default rollup by Customer Name
                Map<String, OrderDL_Util.Tot> totals = OrderDL_Util.rollup(rows, 'Customer');
                res.result = OrderDL_Util.fmtRollupTable(totals, 'Customer Revenue', 'Customer');
            }

            results.add(res);
        }

        return results;
    }
}


