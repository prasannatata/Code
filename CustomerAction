public with sharing class CustomerAction {

    // Filter wrapper
    public class Filter {
        @InvocableVariable public String fieldName;
        @InvocableVariable public String fieldValue;
    }

    // Request wrapper
    public class Request {
        @InvocableVariable public List<Filter> filters; // dynamic filters as list
        @InvocableVariable public Integer topN;         // optional, default 10
    }

    // Response wrapper
    public class Result {
        @InvocableVariable public String summaryJson;   // JSON back to prompt template
    }

    @InvocableMethod(label='Dynamic Customer Query')
    public static List<Result> run(List<Request> requests) {
        List<Result> outputs = new List<Result>();
        if (requests.isEmpty()) return outputs;

        Request req = requests[0];
        Integer topN = (req.topN != null && req.topN > 0) ? req.topN : 10;

        // --- Build base query ---
        String baseQuery = 'SELECT CustomerName__c, COUNT(Id) totalOrders, SUM(Quantity__c) totalQty, SUM(Revenue__c) totalRevenue ' +
                           'FROM Realistic_OrderLine_Datacsv__dlm ' +
                           'WHERE CustomerName__c != null ';

        // Apply filters dynamically
        if (req.filters != null) {
            for (Filter f : req.filters) {
                if (String.isNotBlank(f.fieldName) && String.isNotBlank(f.fieldValue)) {
                    baseQuery += ' AND ' + f.fieldName + ' = \'' + String.escapeSingleQuotes(f.fieldValue) + '\'';
                }
            }
        }

        baseQuery += ' GROUP BY CustomerName__c ORDER BY SUM(Revenue__c) DESC LIMIT ' + topN;

        // --- Execute query ---
        List<AggregateResult> ars = Database.query(baseQuery);

        // Build JSON output
        List<Map<String, Object>> rows = new List<Map<String, Object>>();
        for (AggregateResult ar : ars) {
            Map<String, Object> row = new Map<String, Object>();
            row.put('customer', String.valueOf(ar.get('CustomerName__c')));
            row.put('orders', (Integer)ar.get('totalOrders'));
            row.put('quantity', (Decimal)ar.get('totalQty'));
            row.put('revenue', (Decimal)ar.get('totalRevenue'));
            rows.add(row);
        }

        Result r = new Result();
        r.summaryJson = JSON.serializePretty(rows); // Send JSON for Prompt Template
        outputs.add(r);

        return outputs;
    }
}
CustomerAction.Request req = new CustomerAction.Request();
req.topN = 5;

CustomerAction.Filter f1 = new CustomerAction.Filter();
f1.fieldName = 'OrderStatus__c';
f1.fieldValue = 'Pending';

req.filters = new List<CustomerAction.Filter>{ f1 };

List<CustomerAction.Request> input = new List<CustomerAction.Request>{ req };
List<CustomerAction.Result> res = CustomerAction.run(input);

System.debug(res[0].summaryJson);




name: FormatCustomerSummary
type: prompt_template
input_parameters:
  - name: summaryJson
    type: string
  - name: year
    type: string
    optional: true
  - name: quarter
    type: string
    optional: true
  - name: topN
    type: string
    optional: true
template: |
  You are a Salesforce AI assistant. The Apex action returned structured JSON of customer metrics.

  Task:
  - Parse the JSON: {{summaryJson}}
  - Always format results into a markdown table with the columns: **Customer | Orders | Quantity | Revenue**.
  - Add a heading at the top:
    - If `year` and `quarter` provided → "Top {{topN}} Customers in Q{{quarter}} {{year}}"
    - If only `year` provided → "Top {{topN}} Customers in {{year}}"
    - Otherwise → "Top Customers"

  Example output:

  ## Top 5 Customers in Q1 2025
  | Customer       | Orders | Quantity | Revenue   |
  |----------------|--------|----------|-----------|
  | Mass General   | 12     | 1,234    | $50,000   |
  | Johns Hopkins  | 8      | 950      | $38,200   |

  Render only the table + heading (no explanations).


