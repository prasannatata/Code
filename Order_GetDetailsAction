public with sharing class Order_GetDetailsAction {

    public class Request {
        @InvocableVariable(label='Order Reference') public String orderRef;
    }

    public class Response {
        @InvocableVariable(label='Result') public String result;
    }

    @InvocableMethod(label='Get Order Details')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();

        for (Request r : reqs) {
            Response res = new Response();

            if (String.isBlank(r.orderRef)) {
                res.result = '⚠️ Order reference is required.';
            } else {
                List<Realistic_OrderLine_Datacsv__dll> rows =
                    [SELECT OrderRefNumber__c, CustomerName__c, OrderStatus__c, Modality__c,
                            Vendor__c, OEM__c, PartNumber__c, PartDescription__c,
                            Quantity__c, Revenue__c, SalesRep__c, Requestor__c,
                            OrderCreateDate__c, OrderPODate__c, CustomerID__c, ParentCustomerName__c
                     FROM Realistic_OrderLine_Datacsv__dll
                     WHERE OrderRefNumber__c = :r.orderRef
                     LIMIT 1];

                if (rows.isEmpty()) {
                    res.result = '❌ No order found with reference ' + r.orderRef;
                } else {
                    res.result = OrderDL_Util.fmtOrderCard(rows[0]);
                }
            }
            results.add(res);
        }
        return results;
    }
}


Order_GetDetailsAction.Request req = new Order_GetDetailsAction.Request();
req.orderRef = 'ORD-110'; // Must exist in your DLO

List<Order_GetDetailsAction.Response> resList =
    Order_GetDetailsAction.run(new List<Order_GetDetailsAction.Request>{ req });

System.debug(resList[0].result);

