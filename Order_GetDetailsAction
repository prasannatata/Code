public with sharing class Order_GetDetailsAction {

    public class Request {
        @InvocableVariable(required=true label='Order Reference Number')
        public String orderRef;
    }

    public class Response {
        @InvocableVariable(label='Order Details')
        public String result;
    }

    @InvocableMethod(label='Get Order Details')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();

        for (Request r : reqs) {
            Response res = new Response();

            try {
                List<Realistic_OrderLine_Datacsv__dlm> rows = [
                    SELECT OrderRefNumber__c, CustomerName__c, CustomerID__c,
                           ParentCustomerName__c, ParentCustomerID__c,
                           OrderStatus__c, OrderCreateDate__c, OrderPODate__c,
                           Vendor__c, Modality__c, OEM__c,
                           PartNumber__c, PartDescription__c,
                           Quantity__c, Revenue__c,
                           Requestor__c, SalesRep__c
                    FROM Realistic_OrderLine_Datacsv__dlm
                    WHERE OrderRefNumber__c = :r.orderRef
                    LIMIT 1
                ];

                if (rows.isEmpty()) {
                    res.result = '❌ No order found with reference: ' + r.orderRef;
                } else {
                    res.result = OrderDL_Util.fmtOrderCard(rows[0]);
                }

            } catch (Exception e) {
                res.result = '⚠️ Error while fetching order ' + r.orderRef + ': ' + e.getMessage();
            }

            results.add(res);
        }

        return results;
    }
}


List<Order_GetDetailsAction.Request> reqs = new List<Order_GetDetailsAction.Request>();

// Example: Fetch details for order ORD-1010
Order_GetDetailsAction.Request r = new Order_GetDetailsAction.Request();
r.orderRef = 'ORD-1010';
reqs.add(r);

// Call the action
List<Order_GetDetailsAction.Response> results = Order_GetDetailsAction.run(reqs);

// Debug output
for (Order_GetDetailsAction.Response res : results) {
    System.debug('Order Details Output:\n' + res.result);
}

