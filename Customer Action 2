public with sharing class CustomerAction {

    // Request wrapper (from Agent)
    public class Request {
        @InvocableVariable(label='Year' required=false)
        public Integer year;

        @InvocableVariable(label='Quarter' required=false)
        public Integer quarter;

        @InvocableVariable(label='Top N' required=false)
        public Integer topN;

        @InvocableVariable(label='Extra Filters (JSON)' required=false)
        public String filtersJson; // optional, future-proof for dynamic filters
    }

    // Response wrapper (to Agent)
    public class Result {
        @InvocableVariable(label='Summary JSON')
        public String summaryJson;
    }

    @InvocableMethod(label='Dynamic Customer Summary')
    public static List<Result> run(List<Request> requests) {
        List<Result> outputs = new List<Result>();

        if (requests.isEmpty()) return outputs;
        Request req = requests[0];

        // Default values
        Integer yearVal    = (req.year     != null) ? req.year : Date.today().year();
        Integer quarterVal = (req.quarter  != null) ? req.quarter : null;
        Integer topN       = (req.topN     != null && req.topN > 0) ? req.topN : 10;

        // Base query
        String baseQuery =
            'SELECT CustomerName__c, ' +
            'SUM(Quantity__c) totalQty, ' +
            'SUM(Revenue__c) totalRevenue ' +
            'FROM Realistic_OrderLine_Datacsv__dlm ' +
            'WHERE CALENDAR_YEAR(OrderCreateDate__c) = :yearVal ';

        if (quarterVal != null) {
            baseQuery += 'AND CALENDAR_QUARTER(OrderCreateDate__c) = :quarterVal ';
        }

        baseQuery +=
            'GROUP BY CustomerName__c ' +
            'ORDER BY SUM(Revenue__c) DESC ' +
            'LIMIT :topN';

        // Execute query
        List<AggregateResult> ars = Database.query(baseQuery);

        // Build JSON output
        List<Map<String, Object>> rows = new List<Map<String, Object>>();
        for (AggregateResult ar : ars) {
            Map<String, Object> row = new Map<String, Object>();
            row.put('Customer', ar.get('CustomerName__c'));
            row.put('Quantity', ar.get('totalQty'));
            row.put('Revenue', ar.get('totalRevenue'));
            rows.add(row);
        }

        // Wrap result
        Result r = new Result();
        r.summaryJson = JSON.serializePretty(rows); // structured JSON for prompt template
        outputs.add(r);

        return outputs;
    }
}

// Run CustomerAction with Year 2025, Q1, Top 5
CustomerAction.Request req = new CustomerAction.Request();
req.year = 2025;
req.quarter = 1;
req.topN = 5;

List<CustomerAction.Result> results = CustomerAction.run(new List<CustomerAction.Request>{ req });
System.debug('OUTPUT: ' + results[0].summaryJson);
