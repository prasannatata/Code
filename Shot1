import { LightningElement, track } from 'lwc';
import detectDropOff from '@salesforce/apex/Customer_RevenueDropOffAction.run';
import { ShowToastEvent } from 'lightning/platformShowToastEvent';

export default class RevenueDropOffTable extends LightningElement {
    @track loading = true;
    @track error;
    @track records;

    columns = [
        { label: 'Customer Name', fieldName: 'customerName' },
        { label: 'Period 1 Revenue', fieldName: 'period1Revenue', type: 'currency' },
        { label: 'Period 2 Revenue', fieldName: 'period2Revenue', type: 'currency' },
        { label: 'Drop Amount', fieldName: 'dropAmount', type: 'currency' },
        { label: 'Drop %', fieldName: 'dropPercent', type: 'percent', typeAttributes: { step: '0.01' } }
    ];

    connectedCallback() {
        this.loadData();
    }

    loadData() {
        this.loading = true;
        detectDropOff({
            reqs: [{
                period1Start: null,
                period1End: null,
                period2Start: null,
                period2End: null,
                topN: 10
            }]
        })
            .then((result) => {
                if (result && result.length > 0) {
                    this.records = result[0].dropOffRecords;
                } else {
                    this.records = null;
                }
            })
            .catch((error) => {
                console.error('Error fetching drop-off data', error);
                this.error = error?.body?.message || 'Error loading revenue drop-off data.';
                this.dispatchEvent(
                    new ShowToastEvent({
                        title: 'Error',
                        message: this.error,
                        variant: 'error'
                    })
                );
            })
            .finally(() => {
                this.loading = false;
            });
    }
}

