/**
 * Customer_RevenueDropOffAction.cls
 * ---------------------------------
 * Detects top customers with revenue drop-offs between two periods.
 * Designed for use in Flows, LWC, or Agentforce actions.
 */
public with sharing class Customer_RevenueDropOffAction {

    // ====== REQUEST DTO ======
    public class Request {
        @InvocableVariable(label='Period 1 Start Date (earlier period)')
        public Date period1Start;

        @InvocableVariable(label='Period 1 End Date')
        public Date period1End;

        @InvocableVariable(label='Period 2 Start Date (later period)')
        public Date period2Start;

        @InvocableVariable(label='Period 2 End Date')
        public Date period2End;

        @InvocableVariable(label='Number of Top Customers')
        public Integer topN = 20;
    }

    // ====== RESPONSE DTO ======
    public class Response {
        @InvocableVariable(label='Summary Result')
        public String result;

        @InvocableVariable(label='Revenue Drop-Off Records')
        public List<DropOffRecord> dropOffRecords;
    }

    // ====== RECORD DTO ======
    public class DropOffRecord implements Comparable {
        @InvocableVariable(label='Customer Name')
        public String customerName;

        @InvocableVariable(label='Period 1 Revenue')
        public Decimal period1Revenue;

        @InvocableVariable(label='Period 2 Revenue')
        public Decimal period2Revenue;

        @InvocableVariable(label='Drop Amount')
        public Decimal dropAmount;

        @InvocableVariable(label='Drop Percentage')
        public Decimal dropPercent;

        // Sorting (descending by drop amount)
        public Integer compareTo(Object other) {
            DropOffRecord otherRec = (DropOffRecord) other;
            if (this.dropAmount > otherRec.dropAmount) return -1;
            if (this.dropAmount < otherRec.dropAmount) return 1;
            return 0;
        }
    }

    // ====== MAIN INVOCABLE METHOD ======
    @InvocableMethod(label='Detect Revenue Drop-Off')
    public static List<Response> run(List<Request> reqs) {
        List<Response> allResponses = new List<Response>();

        for (Request req : reqs) {
            Response res = new Response();
            res.dropOffRecords = new List<DropOffRecord>();

            // ====== Handle Missing Dates (default to previous and current quarter) ======
            Date period1Start;
            Date period1End;
            Date period2Start;
            Date period2End;
            String period1Label;
            String period2Label;

            if (req.period1Start == null || req.period2Start == null) {
                Date today = Date.today();
                Integer currentYear = today.year();
                Integer currentQuarter = ((today.month() - 1) / 3) + 1;

                Integer prevQuarter = currentQuarter - 1;
                Integer prevYear = currentYear;

                if (prevQuarter == 0) {
                    prevQuarter = 4;
                    prevYear--;
                }

                // Calculate default quarter boundaries
                period1Start = Date.newInstance(prevYear, ((prevQuarter - 1) * 3) + 1, 1);
                period1End = period1Start.addMonths(3).addDays(-1);
                period2Start = Date.newInstance(currentYear, ((currentQuarter - 1) * 3) + 1, 1);
                period2End = period2Start.addMonths(3).addDays(-1);

                period1Label = 'Q' + prevQuarter + ' ' + prevYear;
                period2Label = 'Q' + currentQuarter + ' ' + currentYear;
            } else {
                // Use provided dates
                period1Start = req.period1Start;
                period1End = req.period1End;
                period2Start = req.period2Start;
                period2End = req.period2End;

                period1Label = period1Start.format() + ' to ' + period1End.format();
                period2Label = period2Start.format() + ' to ' + period2End.format();
            }

            // ====== Query Period 1 Revenues ======
            List<AggregateResult> p1Agg = [
                SELECT CustomerName__c, SUM(Revenue__c) totalRevenue
                FROM Realistic_OrderLine_Datacsv__dlm
                WHERE OrderPODate__c >= :period1Start
                      AND OrderPODate__c <= :period1End
                GROUP BY CustomerName__c
            ];

            // ====== Query Period 2 Revenues ======
            List<AggregateResult> p2Agg = [
                SELECT CustomerName__c, SUM(Revenue__c) totalRevenue
                FROM Realistic_OrderLine_Datacsv__dlm
                WHERE OrderPODate__c >= :period2Start
                      AND OrderPODate__c <= :period2End
                GROUP BY CustomerName__c
            ];

            // ====== Convert to Maps for Easy Lookup ======
            Map<String, Decimal> period1Map = new Map<String, Decimal>();
            Map<String, Decimal> period2Map = new Map<String, Decimal>();

            for (AggregateResult a : p1Agg) {
                period1Map.put((String) a.get('CustomerName__c'), (Decimal) a.get('totalRevenue'));
            }
            for (AggregateResult a : p2Agg) {
                period2Map.put((String) a.get('CustomerName__c'), (Decimal) a.get('totalRevenue'));
            }

            // ====== Detect Drop-Offs ======
            List<DropOffRecord> dropList = new List<DropOffRecord>();

            for (String customer : period1Map.keySet()) {
                Decimal rev1 = period1Map.get(customer);
                Decimal rev2 = period2Map.containsKey(customer) ? period2Map.get(customer) : 0;

                if (rev1 > rev2) {
                    DropOffRecord rec = new DropOffRecord();
                    rec.customerName = customer;
                    rec.period1Revenue = rev1;
                    rec.period2Revenue = rev2;
                    rec.dropAmount = rev1 - rev2;
                    rec.dropPercent = (rev1 > 0) ? ((rev1 - rev2) / rev1) * 100 : 0;
                    dropList.add(rec);
                }
            }

            // ====== Sort and Limit Results ======
            dropList.sort();

            Integer displayCount = Math.min(
                (req.topN != null && req.topN > 0) ? req.topN : 20,
                dropList.size()
            );

            List<DropOffRecord> finalList = (displayCount > 0)
                ? dropList.subList(0, displayCount)
                : new List<DropOffRecord>();

            // ====== Prepare Response ======
            res.dropOffRecords = finalList;
            if (finalList.isEmpty()) {
                res.result = 'No revenue drop-offs detected between ' +
                    period1Label + ' and ' + period2Label + '.';
            } else {
                res.result = 'Found ' + displayCount + 
                    ' customers with revenue decline between ' +
                    period1Label + ' and ' + period2Label + '.';
            }

            allResponses.add(res);
        }

        return allResponses;
    }
}



