public with sharing class Order_GetByCompositeFiltersAction {
    
    public class Request {
        @InvocableVariable(label='Order Status' required=false)
        public String status;
        
        @InvocableVariable(label='PO Date Before' required=false)
        public Date poDateBefore;
        
        @InvocableVariable(label='Requestor' required=false)
        public String requestor;
        
        @InvocableVariable(label='OEM' required=false)
        public String oemName;
        
        @InvocableVariable(label='Limit' required=false)
        public Integer limitSize;
    }
    
    public class Response {
        @InvocableVariable(label='Summary')
        public String summaryText;
        
        @InvocableVariable(label='Table Data')
        public String tableData;
        
        @InvocableVariable(label='Record Count')
        public Integer recordCount;
    }
    
    @InvocableMethod(label='Get Orders By Composite Filters' description='Find orders matching multiple criteria')
    public static List<Response> run(List<Request> requests) {
        List<Response> results = new List<Response>();
        
        if (requests == null || requests.isEmpty()) {
            Response emptyRes = new Response();
            emptyRes.summaryText = 'No request provided';
            emptyRes.tableData = '';
            emptyRes.recordCount = 0;
            results.add(emptyRes);
            return results;
        }
        
        Request req = requests[0];
        Response res = new Response();
        
        try {
            Integer limitValue = (req.limitSize != null && req.limitSize > 0) ? req.limitSize : 50;
            
            String status = req.status;
            Date poDateBefore = req.poDateBefore;
            String requestor = req.requestor;
            String oemName = req.oemName;
            
            String soql = 
                'SELECT OrderRefNumber__c, CustomerName__c, ParentCustomerName__c, ' +
                'OrderStatus__c, OrderPODate__c, Requestor__c, OEM__c, ' +
                'Vendor__c, Modality__c, Quantity__c, Revenue__c, OrderCreateDate__c ' +
                'FROM Realistic_OrderLine_Datacsv__dlm';
            
            List<String> conditions = new List<String>();
            
            if (String.isNotBlank(status)) {
                conditions.add('OrderStatus__c = :status');
            }
            
            if (poDateBefore != null) {
                conditions.add('OrderPODate__c < :poDateBefore');
            }
            
            if (String.isNotBlank(requestor)) {
                conditions.add('Requestor__c = :requestor');
            }
            
            if (String.isNotBlank(oemName)) {
                conditions.add('OEM__c = :oemName');
            }
            
            if (!conditions.isEmpty()) {
                soql += ' WHERE ' + String.join(conditions, ' AND ');
            }
            
            soql += ' ORDER BY OrderCreateDate__c DESC LIMIT ' + limitValue;
            
            System.debug('Executing SOQL: ' + soql);
            
            List<Realistic_OrderLine_Datacsv__dlm> orders = Database.query(soql);
            
            if (orders.isEmpty()) {
                res.summaryText = 'No orders found matching the specified filters.';
                res.tableData = '';
                res.recordCount = 0;
            } else {
                res.summaryText = buildSummary(orders, req);
                res.tableData = buildTable(orders);
                res.recordCount = orders.size();
            }
            
        } catch (Exception e) {
            res.summaryText = 'Error: ' + e.getMessage();
            res.tableData = '';
            res.recordCount = 0;
            System.debug('Error: ' + e.getMessage() + '\n' + e.getStackTraceString());
        }
        
        results.add(res);
        return results;
    }
    
    private static String buildSummary(List<Realistic_OrderLine_Datacsv__dlm> orders, Request req) {
        List<String> filters = new List<String>();
        
        if (String.isNotBlank(req.status)) {
            filters.add('Status: ' + req.status);
        }
        if (req.poDateBefore != null) {
            filters.add('PO Date before: ' + req.poDateBefore.format());
        }
        if (String.isNotBlank(req.requestor)) {
            filters.add('Requestor: ' + req.requestor);
        }
        if (String.isNotBlank(req.oemName)) {
            filters.add('OEM: ' + req.oemName);
        }
        
        String filterText = !filters.isEmpty() ? ' (' + String.join(filters, ', ') + ')' : '';
        
        Decimal totalRevenue = 0;
        Decimal totalQty = 0;
        
        for (Realistic_OrderLine_Datacsv__dlm order : orders) {
            if (order.Revenue__c != null) {
                totalRevenue += order.Revenue__c;
            }
            if (order.Quantity__c != null) {
                totalQty += order.Quantity__c;
            }
        }
        
        String summary = 'Found ' + orders.size() + ' orders' + filterText + '.' + '\n';
        summary += 'Total Revenue: $' + totalRevenue.setScale(2).format() + '\n';
        summary += 'Total Quantity: ' + totalQty.setScale(0);
        
        return summary;
    }
    
    private static String buildTable(List<Realistic_OrderLine_Datacsv__dlm> orders) {
        String output = '';
        Integer num = 1;
        
        for (Realistic_OrderLine_Datacsv__dlm order : orders) {
            output += num + '. **' + (order.OrderRefNumber__c != null ? order.OrderRefNumber__c : 'N/A') + '**' + '\n';
            output += '   • Customer: ' + (order.CustomerName__c != null ? order.CustomerName__c : 'N/A') + '\n';
            
            if (order.ParentCustomerName__c != null) {
                output += '   • Parent Customer: ' + order.ParentCustomerName__c + '\n';
            }
            
            output += '   • Status: ' + (order.OrderStatus__c != null ? order.OrderStatus__c : 'N/A') + '\n';
            output += '   • PO Date: ' + (order.OrderPODate__c != null ? order.OrderPODate__c.format() : 'N/A') + '\n';
            output += '   • Requestor: ' + (order.Requestor__c != null ? order.Requestor__c : 'N/A') + '\n';
            output += '   • OEM: ' + (order.OEM__c != null ? order.OEM__c : 'N/A') + '\n';
            output += '   • Vendor: ' + (order.Vendor__c != null ? order.Vendor__c : 'N/A') + '\n';
            output += '   • Modality: ' + (order.Modality__c != null ? order.Modality__c : 'N/A') + '\n';
            output += '   • Quantity: ' + (order.Quantity__c != null ? String.valueOf(order.Quantity__c.setScale(0)) : 'N/A') + '\n';
            output += '   • Revenue: ' + (order.Revenue__c != null ? '$' + order.Revenue__c.setScale(2).format() : 'N/A') + '\n' + '\n';
            
            num++;
        }
        
        return output;
    }
}

