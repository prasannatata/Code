public with sharing class Customer_TopRevenueAction {

    public class Request {
        @InvocableVariable(required=false)
        public Integer limitSize;
    }

    public class Response {
        @InvocableVariable(label='Result')
        public String result;
    }

    @InvocableMethod(label='Top Revenue Customers' description='List top customers by revenue')
    public static List<Response> run(List<Request> reqs) {
        Integer limitValue = 10;
        if (reqs != null && !reqs.isEmpty() && reqs[0].limitSize != null && reqs[0].limitSize > 0) {
            limitValue = reqs[0].limitSize;
        }

        List<Response> results = new List<Response>();

        List<AggregateResult> rows = [
            SELECT CustomerName__c custName,
                   COUNT(Id) orderCount,
                   SUM(Revenue__c) sumRevenue
            FROM Realistic_OrderLine_Datacsv__dlm
            GROUP BY CustomerName__c
            ORDER BY SUM(Revenue__c) DESC
            LIMIT :limitValue
        ];

        Response r = new Response();
        if (rows.isEmpty()) {
            r.result = 'No customer revenue data found.';
        } else {
            String output = '';
            for (AggregateResult ar : rows) {
                String custName = (String) ar.get('custName');
                Integer orders = (Integer) ar.get('orderCount');
                Decimal revenue = (Decimal) ar.get('sumRevenue');
                output += custName + ' | ' + orders + ' | $' + revenue.setScale(2) + '\n';
            }
            r.result = output;
        }
        results.add(r);

        return results;
    }
}

// Prepare test request
List<Customer_TopRevenueAction.Request> reqs = new List<Customer_TopRevenueAction.Request>();

Customer_TopRevenueAction.Request r = new Customer_TopRevenueAction.Request();
r.limitSize = 5;   // try with top 5 customers
reqs.add(r);

// Run the action
List<Customer_TopRevenueAction.Response> results = Customer_TopRevenueAction.run(reqs);

// Debug output
for (Customer_TopRevenueAction.Response res : results) {
    System.debug('>>> Result:\n' + res.result);
}
