**Customer_RevenueDropOffAction.cls**

```apex
public with sharing class Customer_RevenueDropOffAction {

    public class Request {
        @InvocableVariable(label='Period 1 Start Date (earlier period)')
        public Date period1Start;
        @InvocableVariable(label='Period 1 End Date')
        public Date period1End;

        @InvocableVariable(label='Period 2 Start Date (later period)')
        public Date period2Start;
        @InvocableVariable(label='Period 2 End Date')
        public Date period2End;

        @InvocableVariable(label='Number of Top Customers')
        public Integer topN = 20;
    }

    public class Response {
        @InvocableVariable(label='Summary Text')
        public String summaryText;

        @InvocableVariable(label='Drop Off Records')
        public List<DropOffWrapper> dropOffRecords;
    }

    @InvocableMethod(label='Detect Revenue Drop-Off')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();

        for (Request r : reqs) {
            Response res = new Response();
            res.dropOffRecords = new List<DropOffWrapper>();

            // Query period 1
            List<AggregateResult> period1Results = [
                SELECT CustomerName__c customer, SUM(Revenue__c) totalRev
                FROM Realistic_OrderLine_Datacsv__dlm
                WHERE OrderPODate__c >= :r.period1Start AND OrderPODate__c <= :r.period1End
                GROUP BY CustomerName__c
            ];

            // Query period 2
            List<AggregateResult> period2Results = [
                SELECT CustomerName__c customer, SUM(Revenue__c) totalRev
                FROM Realistic_OrderLine_Datacsv__dlm
                WHERE OrderPODate__c >= :r.period2Start AND OrderPODate__c <= :r.period2End
                GROUP BY CustomerName__c
            ];

            // Map results
            Map<String, Decimal> period1Map = new Map<String, Decimal>();
            for (AggregateResult ar : period1Results) {
                period1Map.put((String)ar.get('customer'), (Decimal)ar.get('totalRev'));
            }

            Map<String, Decimal> period2Map = new Map<String, Decimal>();
            for (AggregateResult ar : period2Results) {
                period2Map.put((String)ar.get('customer'), (Decimal)ar.get('totalRev'));
            }

            // Compare
            for (String cust : period1Map.keySet()) {
                Decimal rev1 = period1Map.get(cust);
                Decimal rev2 = period2Map.containsKey(cust) ? period2Map.get(cust) : 0;

                if (rev2 < rev1) {
                    DropOffWrapper row = new DropOffWrapper();
                    row.customerName = cust;
                    row.period1Revenue = '$' + rev1.setScale(2).format();
                    row.period2Revenue = '$' + rev2.setScale(2).format();
                    row.dropAmount = '$' + (rev1 - rev2).setScale(2).format();
                    row.dropPercentage = (((rev1 - rev2) / rev1) * 100).setScale(1) + '%';
                    res.dropOffRecords.add(row);
                }
            }

            res.summaryText = res.dropOffRecords.isEmpty()
                ? 'No revenue drop-offs detected.'
                : 'Found ' + res.dropOffRecords.size() + ' customers with revenue decline.';

            results.add(res);
        }

        return results;
    }
}
```

