public with sharing class Order_GetByQuarterAction {

    // Request wrapper
    public class Request {
        @InvocableVariable(required=true)
        public Integer quarter;   // 1–4
        @InvocableVariable(required=true)
        public Integer year;      // e.g., 2025
    }

    // Response wrapper
    public class Response {
        @InvocableVariable
        public String result;
    }

    @InvocableMethod(label='Get Orders By Quarter')
    public static List<Response> run(List<Request> requests) {
        List<Response> results = new List<Response>();

        for (Request r : requests) {
            Response res = new Response();

            Date startDate = Date.newInstance(r.year, (r.quarter - 1) * 3 + 1, 1);
            Date endDate   = startDate.addMonths(3).addDays(-1);

            String query = 'SELECT OrderRefNumber__c, CustomerName__c, Revenue__c, OrderPODate__c ' +
                           'FROM Realistic_OrderLine_Datacsv__dlm ' +
                           'WHERE OrderPODate__c >= :startDate AND OrderPODate__c <= :endDate';

            List<Realistic_OrderLine_Datacsv__dlm> rows = Database.query(query);

            if (rows.isEmpty()) {
                res.result = '❌ No orders found for Q' + r.quarter + ' ' + r.year;
            } else {
                res.result = OrderDL_Util.fmtOrdersTable(
                    rows,
                    'Orders for Q' + r.quarter + ' ' + r.year
                );
            }

            results.add(res);
        }
        return results;
    }
}
// Test Q1 2025 Orders
Order_GetByQuarterAction.Request req = new Order_GetByQuarterAction.Request();
req.quarter = 1;
req.year = 2025;

List<Order_GetByQuarterAction.Response> results =
    Order_GetByQuarterAction.run(new List<Order_GetByQuarterAction.Request>{ req });

System.debug('==== Q1 Orders ====');
for (Order_GetByQuarterAction.Response r : results) {
    System.debug(r.result);
}
