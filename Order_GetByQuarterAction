public class Order_GetByQuarterAction {
    public class Request {
        @InvocableVariable(required=true)
        public Integer quarter;
        @InvocableVariable(required=true)
        public Integer year;
    }

    public class Response {
        @InvocableVariable
        public String result;
    }

    @InvocableMethod
    public static List<Response> run(List<Request> requests) {
        List<Response> results = new List<Response>();

        for (Request r : requests) {
            Date startDate = Date.newInstance(r.year, (r.quarter - 1) * 3 + 1, 1);
            Date endDate = startDate.addMonths(3).addDays(-1);

            String query = OrderDL_Util.buildBaseQuery() +
                           'WHERE OrderPODate__c >= :startDate AND OrderPODate__c <= :endDate';

            List<Realistic_OrderLine_Datacsv__dlm> rows = Database.query(query);

            Response res = new Response();
            res.result = rows.isEmpty() ?
                '❌ No orders found for Q' + r.quarter + ' ' + r.year :
                OrderDL_Util.fmtOrdersTable(rows, 'Orders for Q' + r.quarter + ' ' + r.year);

            results.add(res);
        }
        return results;
    }
}
