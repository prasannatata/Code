public with sharing class Order_GetByQuarterAction {
    public class Request {
        @InvocableVariable public Integer quarter;
        @InvocableVariable public Integer year;
    }
    public class Response { @InvocableVariable public String result; }

    @InvocableMethod
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();
        for (Request r : reqs) {
            Response res = new Response();

            Date startDate = Date.newInstance(r.year, ((r.quarter - 1) * 3) + 1, 1);
            Date endDate = startDate.addMonths(3).addDays(-1);

            String query = 'SELECT ' + OrderDL_Util.BASE_FIELDS +
                           ' FROM Realistic_OrderLine_Datacsv__dlm ' +
                           'WHERE OrderPODate__c >= :startDate AND OrderPODate__c <= :endDate';

            List<Realistic_OrderLine_Datacsv__dlm> rows = Database.query(query);

            if (rows.isEmpty()) res.result = '❌ No orders found for Q' + r.quarter + ' ' + r.year;
            else res.result = OrderDL_Util.fmtOrdersTable(rows, 'Orders for Q' + r.quarter + ' ' + r.year);

            results.add(res);
        }
        return results;
    }
}



