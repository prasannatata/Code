public with sharing class Order_GetByOEMAction {

    public class Request {
        @InvocableVariable(label='OEM Name (optional)')
        public String oemName;
    }

    public class Response {
        @InvocableVariable(label='Result')
        public String result;
    }

    @InvocableMethod(label='Get Orders By OEM')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();

        for (Request r : reqs) {
            Response res = new Response();

            // --- Build base query ---
            String baseQuery = 'SELECT OEM__c, Quantity__c, Revenue__c ' +
                               'FROM Realistic_OrderLine_Datacsv__dlm';
            if (!String.isBlank(r.oemName)) {
                baseQuery += ' WHERE OEM__c = \'' + String.escapeSingleQuotes(r.oemName) + '\'';
            }

            // --- Execute query ---
            List<Realistic_OrderLine_Datacsv__dlm> rows = Database.query(baseQuery);

            if (rows.isEmpty()) {
                if (!String.isBlank(r.oemName)) {
                    res.result = '❌ No orders found for OEM: ' + r.oemName;
                } else {
                    res.result = '❌ No OEM data found.';
                }
            } else {
                // --- Aggregate rollup ---
                Map<String, OrderDL_Util.Tot> totals = OrderDL_Util.rollup(rows, 'OEM');
                res.result = OrderDL_Util.fmtRollupTable(totals, 'OEM Performance', 'OEM');
            }

            results.add(res);
        }

        return results;
    }
}


// Case 1: All OEMs
Order_GetByOEMAction.Request r1 = new Order_GetByOEMAction.Request();
r1.oemName = null;

List<Order_GetByOEMAction.Response> res1 = Order_GetByOEMAction.run(new List<Order_GetByOEMAction.Request>{ r1 });
System.debug('== All OEMs == ' + res1[0].result);

