public with sharing class Order_GetByOEMAction {

    public class Request {
        @InvocableVariable(label='OEM Name (Optional)')
        public String oemName;
    }

    public class Response {
        @InvocableVariable(label='Result')
        public String result;
    }

    @InvocableMethod(label='Get Orders By OEM')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();

        for (Request r : reqs) {
            Response res = new Response();

            // Base query
            String baseQuery =
                'SELECT OEM__c, CustomerName__c, Quantity__c, Revenue__c ' +
                'FROM Realistic_OrderLine_Datacsv__dlm WHERE 1=1';

            // Add optional OEM filter
            if (!String.isBlank(r.oemName)) {
                baseQuery += ' AND OEM__c = \'' + String.escapeSingleQuotes(r.oemName) + '\'';
            }

            // Execute query
            List<Realistic_OrderLine_Datacsv__dlm> rows = Database.query(baseQuery);

            if (rows.isEmpty()) {
                if (!String.isBlank(r.oemName)) {
                    res.result = '❌ No orders found for OEM: ' + r.oemName;
                } else {
                    res.result = '❌ No OEM data found.';
                }
            } else {
                Map<String, OrderDL_Util.Tot> totals = OrderDL_Util.rollup(rows, 'OEM');
                res.result = OrderDL_Util.fmtRollupTable(totals, 'OEM Performance', 'OEM');
            }

            results.add(res);
        }
        return results;
    }
}

