public with sharing class Order_GetByOEMAction {

    public class Request {
        @InvocableVariable(label='OEM Name (Optional)')
        public String oemName;
    }

    public class Response {
        @InvocableVariable(label='Result')
        public String result;
    }

    @InvocableMethod(label='Get Orders By OEM')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();

        for (Request r : reqs) {
            Response res = new Response();

            String baseQuery =
                'SELECT OEM__c, Quantity__c, Revenue__c ' +
                'FROM Realistic_OrderLine_Datacsv__dlm';

            if (!String.isBlank(r.oemName)) {
                baseQuery += ' WHERE OEM__c = :r.oemName';
            }

            List<Realistic_OrderLine_Datacsv__dlm> rows =
                Database.query(baseQuery);

            if (rows.isEmpty()) {
                res.result = !String.isBlank(r.oemName)
                    ? '❌ No orders found for OEM ' + r.oemName
                    : '❌ No OEM data found.';
            } else {
                Map<String, OrderDL_Util.Tot> totals =
                    OrderDL_Util.rollup(rows, 'OEM');
                res.result =
                    OrderDL_Util.fmtRollupTable(
                        totals,
                        !String.isBlank(r.oemName)
                            ? r.oemName + ' OEM Performance'
                            : 'OEM Performance',
                        'OEM'
                    );
            }

            results.add(res);
        }
        return results;
    }
}

