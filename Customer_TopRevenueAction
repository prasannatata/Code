public class Customer_TopRevenueAction {
    public class Request {
        @InvocableVariable
        public Integer topN; // optional, defaults to 5
    }

    public class Response {
        @InvocableVariable
        public String result;
    }

    @InvocableMethod
    public static List<Response> run(List<Request> requests) {
        List<Response> results = new List<Response>();

        Integer limitVal = (requests.isEmpty() || requests[0].topN == null) ? 5 : requests[0].topN;

        String query = 'SELECT CustomerName__c, SUM(Revenue__c) totalRevenue ' +
                       'FROM Realistic_OrderLine_Datacsv__dlm ' +
                       'GROUP BY CustomerName__c ' +
                       'ORDER BY totalRevenue DESC ' +
                       'LIMIT :limitVal';

        List<AggregateResult> rows = Database.query(query);

        Response res = new Response();
        if (rows.isEmpty()) {
            res.result = '❌ No customers found.';
        } else {
            String header = '## Top ' + limitVal + ' Customers by Revenue\n' +
                            'Customer | Total Revenue\n' +
                            '--- | ---\n';

            String body = '';
            for (AggregateResult ar : rows) {
                body += (String) ar.get('CustomerName__c') + ' | $' + ar.get('totalRevenue') + '\n';
            }
            res.result = header + body;
        }

        results.add(res);
        return results;
    }
}
