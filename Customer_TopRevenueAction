public with sharing class Customer_TopRevenueAction {
    public class Request {
        @InvocableVariable(label='Top N Customers')
        public Integer topN;
    }
    public class Response {
        @InvocableVariable(label='Result')
        public String result;
    }

    @InvocableMethod(label='Get Top Customers by Revenue')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();
        for (Request r : reqs) {
            Response res = new Response();
            Integer limitN = (r.topN != null && r.topN > 0) ? r.topN : 10;

            Map<String, Decimal> totals = new Map<String, Decimal>();
            Map<String, String> parents = new Map<String, String>();

            for (Realistic_OrderLine_Datacsv__dlm o : [
                SELECT CustomerName__c, ParentCustomerName__c, Revenue__c
                FROM Realistic_OrderLine_Datacsv__dlm
            ]) {
                totals.put(o.CustomerName__c, (totals.containsKey(o.CustomerName__c) ? totals.get(o.CustomerName__c) : 0) + o.Revenue__c);
                parents.put(o.CustomerName__c, o.ParentCustomerName__c);
            }

            List<String> sortedCustomers = new List<String>(totals.keySet());
            sortedCustomers.sort(new List<String>{
                'DESC' // by revenue
            });

            String output = '## Top ' + limitN + ' Customers by Revenue\n';
            output += 'Customer | Parent | Total Revenue\n---|---|---\n';

            Integer count = 0;
            for (String cust : sortedCustomers) {
                output += cust + ' | ' + parents.get(cust) + ' | $' + totals.get(cust) + '\n';
                count++;
                if (count >= limitN) break;
            }

            res.result = output;
            results.add(res);
        }
        return results;
    }
}



