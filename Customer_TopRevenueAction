public with sharing class Customer_TopRevenueAction {
    
    // --------------------------
    // Request Wrapper
    // --------------------------
    public class Request {
        @InvocableVariable(label='Year' required=false)
        public Integer year;
        
        @InvocableVariable(label='Quarter (1-4)' required=false)
        public Integer quarter;
        
        @InvocableVariable(label='Limit' required=false)
        public Integer limitSize;
        
        @InvocableVariable(label='Minimum Revenue' required=false)
        public Decimal minRevenue;
        
        @InvocableVariable(label='Customer Name Filter' required=false)
        public String customerNameFilter;
        
        @InvocableVariable(label='Group By Field' required=false)
        public String groupByField; // CustomerName__c, Vendor__c, Modality__c, etc.
    }
    
    // --------------------------
    // Response Wrapper
    // --------------------------
    public class Result {
        @InvocableVariable(label='Customer/Group')
        public String customer;
        
        @InvocableVariable(label='Parent Customer')
        public String parentCustomer;
        
        @InvocableVariable(label='Total Orders')
        public Integer orders;
        
        @InvocableVariable(label='Total Revenue')
        public Decimal revenue;
        
        @InvocableVariable(label='Heading')
        public String heading;
        
        @InvocableVariable(label='Error Message')
        public String errorMessage;
    }
    
    // --------------------------
    // Main Invocable Method
    // --------------------------
    @InvocableMethod(
        label='Get Top Customers by Revenue' 
        description='Returns top customers (or groups) by revenue with flexible filtering'
    )
    public static List<Result> run(List<Request> requests) {
        List<Result> outputs = new List<Result>();
        if (requests == null || requests.isEmpty()) return outputs;
        
        Request req = requests[0];
        
        try {
            // Default values
            Integer year = (req.year != null) ? req.year : Date.today().year();
            Integer quarter = req.quarter;
            Integer limitSize = (req.limitSize != null && req.limitSize > 0) ? req.limitSize : 10;
            Decimal minRevenue = req.minRevenue;
            String customerFilter = req.customerNameFilter;
            String groupByField = String.isNotBlank(req.groupByField) ? req.groupByField : 'CustomerName__c';
            
            // Validate inputs
            if (quarter != null && (quarter < 1 || quarter > 4)) {
                return errorOutput('Invalid quarter: ' + quarter + '. Must be 1-4.');
            }
            if (year < 1900 || year > 2100) {
                return errorOutput('Invalid year: ' + year);
            }
            
            // Date range calculation
            Date startDate = Date.newInstance(year, 1, 1);
            Date endDate = Date.newInstance(year, 12, 31);
            if (quarter != null) {
                Integer startMonth = (quarter - 1) * 3 + 1;
                Integer endMonth = startMonth + 2;
                startDate = Date.newInstance(year, startMonth, 1);
                endDate = Date.newInstance(year, endMonth, Date.daysInMonth(year, endMonth));
            }
            
            // Build SOQL
            String soql = buildQuery(startDate, endDate, limitSize, minRevenue, customerFilter, groupByField);
            System.debug('Executing SOQL: ' + soql);
            
            // Execute
            List<AggregateResult> ars = Database.query(soql);
            
            // Heading
            String heading = buildHeading(year, quarter, limitSize, groupByField);
            
            // Process results
            for (AggregateResult ar : ars) {
                Result r = new Result();
                r.customer = (String)ar.get(groupByField);
                if (groupByField == 'CustomerName__c') {
                    r.parentCustomer = (String)ar.get('ParentCustomerName__c');
                }
                r.orders = (Integer)ar.get('totalOrders');
                r.revenue = (Decimal)ar.get('totalRevenue');
                r.heading = heading;
                outputs.add(r);
            }
            
            // No data case
            if (outputs.isEmpty()) {
                return errorOutput('No data found for the specified criteria. ' + heading);
            }
            
        } catch (Exception e) {
            return errorOutput('Error: ' + e.getMessage());
        }
        
        return outputs;
    }
    
    // --------------------------
    // Build SOQL dynamically
    // --------------------------
    private static String buildQuery(
        Date startDate,
        Date endDate,
        Integer limitSize,
        Decimal minRevenue,
        String customerFilter,
        String groupByField
    ) {
        String soql =
            'SELECT ' + groupByField + ', ' +
            (groupByField == 'CustomerName__c' ? 'ParentCustomerName__c, ' : '') +
            'COUNT(Id) totalOrders, ' +
            'SUM(Revenue__c) totalRevenue ' +
            'FROM Realistic_OrderLine_Datacsv__dlm ' +
            'WHERE OrderCreateDate__c >= :startDate ' +
            'AND OrderCreateDate__c <= :endDate ';
        
        if (String.isNotBlank(customerFilter) && groupByField == 'CustomerName__c') {
            soql += 'AND CustomerName__c LIKE \'%' + String.escapeSingleQuotes(customerFilter) + '%\' ';
        }
        
        soql += 'GROUP BY ' + groupByField;
        if (groupByField == 'CustomerName__c') {
            soql += ', ParentCustomerName__c ';
        }
        
        if (minRevenue != null && minRevenue > 0) {
            soql += 'HAVING SUM(Revenue__c) >= ' + minRevenue + ' ';
        }
        
        soql += 'ORDER BY SUM(Revenue__c) DESC NULLS LAST ' +
                'LIMIT ' + limitSize;
        
        return soql;
    }
    
    // --------------------------
    // Heading builder
    // --------------------------
    private static String buildHeading(Integer year, Integer quarter, Integer limitSize, String groupByField) {
        String heading = 'Top ' + limitSize + ' ' + groupByField.replace('__c','') + 's by revenue in ';
        if (quarter != null) heading += 'Q' + quarter + ' ';
        heading += year;
        return heading;
    }
    
    // --------------------------
    // Error utility
    // --------------------------
    private static List<Result> errorOutput(String message) {
        Result r = new Result();
        r.errorMessage = message;
        return new List<Result>{ r };
    }
}
