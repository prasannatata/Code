public with sharing class Customer_TopRevenueAction {
    public class Request { @InvocableVariable public Integer topN; }
    public class Response { @InvocableVariable public String result; }

    @InvocableMethod
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();
        for (Request r : reqs) {
            Response res = new Response();

            String query = 'SELECT ' + OrderDL_Util.BASE_FIELDS +
                           ' FROM Realistic_OrderLine_Datacsv__dlm';

            List<Realistic_OrderLine_Datacsv__dlm> rows = Database.query(query);
            Map<String, OrderDL_Util.Tot> totals = OrderDL_Util.rollup(rows, 'Customer');

            List<String> sorted = new List<String>(totals.keySet());
            sorted.sort((a, b) => totals.get(b).revenue.compareTo(totals.get(a).revenue));

            String out = '## Top Customers by Revenue\nCustomer | Orders | Qty | Revenue\n--- | --- | --- | ---\n';
            Integer count = 0;
            for (String c : sorted) {
                if (count++ >= (r.topN == null ? 10 : r.topN)) break;
                OrderDL_Util.Tot t = totals.get(c);
                out += c + ' | ' + t.count + ' | ' + t.qty + ' | $' + t.revenue + '\n';
            }
            res.result = out;

            results.add(res);
        }
        return results;
    }
}
