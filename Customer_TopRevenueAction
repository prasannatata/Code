public with sharing class Customer_TopRevenueAction {
    
    // Input wrapper for better structure
    public class Request {
        @InvocableVariable(label='Year' required=false)
        public Integer year;
        
        @InvocableVariable(label='Quarter (1-4)' required=false)
        public Integer quarter;
        
        @InvocableVariable(label='Limit' required=false)
        public Integer limitSize;
        
        @InvocableVariable(label='Minimum Revenue' required=false)
        public Decimal minRevenue;
        
        @InvocableVariable(label='Customer Name Filter' required=false)
        public String customerNameFilter;
    }
    
    public class Result {
        @InvocableVariable(label='Customer Name')
        public String customer;
        
        @InvocableVariable(label='Parent Customer')
        public String parentCustomer;
        
        @InvocableVariable(label='Total Orders')
        public Integer orders;
        
        @InvocableVariable(label='Total Revenue')
        public Decimal revenue;
        
        @InvocableVariable(label='Heading')
        public String heading;
        
        @InvocableVariable(label='Error Message')
        public String errorMessage;
    }
    
    @InvocableMethod(
        label='Get Top Customers by Revenue' 
        description='Returns top customers by revenue with flexible filtering'
    )
    public static List<Result> run(List<Request> requests) {
        List<Result> outputs = new List<Result>();
        
        if (requests == null || requests.isEmpty()) {
            return outputs;
        }
        
        Request req = requests[0];
        
        try {
            // Set defaults and validate
            Integer year = (req.year != null) ? req.year : Date.today().year();
            Integer quarter = req.quarter;
            Integer limitSize = (req.limitSize != null && req.limitSize > 0) ? req.limitSize : 10;
            Decimal minRevenue = req.minRevenue;
            String customerFilter = req.customerNameFilter;
            
            // Validate quarter
            if (quarter != null && (quarter < 1 || quarter > 4)) {
                Result errorResult = new Result();
                errorResult.errorMessage = 'Invalid quarter: ' + quarter + '. Must be 1-4.';
                outputs.add(errorResult);
                return outputs;
            }
            
            // Validate year
            if (year < 1900 || year > 2100) {
                Result errorResult = new Result();
                errorResult.errorMessage = 'Invalid year: ' + year;
                outputs.add(errorResult);
                return outputs;
            }
            
            // Build dynamic query
            String soql = buildQuery(year, quarter, limitSize, minRevenue, customerFilter);
            
            // Execute query
            List<AggregateResult> ars = Database.query(soql);
            
            // Process results
            String heading = buildHeading(year, quarter, limitSize);
            
            for (AggregateResult ar : ars) {
                Result r = new Result();
                r.customer = (String)ar.get('CustomerName__c');
                r.parentCustomer = (String)ar.get('ParentCustomerName__c');
                r.orders = (Integer)ar.get('totalOrders');
                r.revenue = (Decimal)ar.get('totalRevenue');
                r.heading = heading;
                outputs.add(r);
            }
            
            // If no results found
            if (outputs.isEmpty()) {
                Result noDataResult = new Result();
                noDataResult.heading = heading;
                noDataResult.errorMessage = 'No data found for the specified criteria.';
                outputs.add(noDataResult);
            }
            
        } catch (Exception e) {
            Result errorResult = new Result();
            errorResult.errorMessage = 'Error: ' + e.getMessage();
            outputs.add(errorResult);
        }
        
        return outputs;
    }
    
    // Build SOQL query dynamically based on filters
    private static String buildQuery(
        Integer year, 
        Integer quarter, 
        Integer limitSize,
        Decimal minRevenue,
        String customerFilter
    ) {
        String soql = 
            'SELECT CustomerName__c, ParentCustomerName__c, ' +
            'COUNT(Id) totalOrders, ' +
            'SUM(Revenue__c) totalRevenue ' +
            'FROM Realistic_OrderLine_Datacsv__dlm ' +
            'WHERE CALENDAR_YEAR(OrderCreateDate__c) = :year ';
        
        // Add quarter filter if specified
        if (quarter != null) {
            soql += 'AND CALENDAR_QUARTER(OrderCreateDate__c) = :quarter ';
        }
        
        // Add customer name filter if specified
        if (String.isNotBlank(customerFilter)) {
            soql += 'AND CustomerName__c LIKE :customerFilter ';
        }
        
        // Group and order
        soql += 'GROUP BY CustomerName__c, ParentCustomerName__c ';
        
        // Add minimum revenue filter (using HAVING for aggregates)
        if (minRevenue != null && minRevenue > 0) {
            soql += 'HAVING SUM(Revenue__c) >= :minRevenue ';
        }
        
        soql += 'ORDER BY SUM(Revenue__c) DESC NULLS LAST ' +
                'LIMIT :limitSize';
        
        return soql;
    }
    
    // Build heading text
    private static String buildHeading(Integer year, Integer quarter, Integer limitSize) {
        String heading = 'Top ' + limitSize + ' customers by revenue in ';
        
        if (quarter != null) {
            heading += 'Q' + quarter + ' ';
        }
        
        heading += year;
        
        return heading;
    }
}


// Example 1: Top 5 customers in Q1 2025
Customer_TopRevenueAction.Request req1 = new Customer_TopRevenueAction.Request();
req1.year = 2025;
req1.quarter = 1;
req1.limitSize = 5;

List<Customer_TopRevenueAction.Result> results1 = 
    Customer_TopRevenueAction.run(new List<Customer_TopRevenueAction.Request>{ req1 });

System.debug('=== Top 5 Customers in Q1 2025 ===');
for (Customer_TopRevenueAction.Result r : results1) {
    if (String.isBlank(r.errorMessage)) {
        System.debug(r.customer + ' (' + r.parentCustomer + '): $' + r.revenue);
    } else {
        System.debug('Error: ' + r.errorMessage);
    }
}

