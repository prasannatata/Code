public with sharing class Customer_TopRevenueAction {

    // Request wrapper
    public class Request {
        @InvocableVariable public Integer year;
        @InvocableVariable public Integer quarter; // optional
        @InvocableVariable public Integer limit;
    }

    // Response wrapper
    public class Result {
        @InvocableVariable public String customer;
        @InvocableVariable public Integer orders;
        @InvocableVariable public Decimal revenue;
    }

    @InvocableMethod(label='Get Top Customers by Revenue')
    public static List<Result> run(List<Request> requests) {
        List<Result> results = new List<Result>();

        if (requests.isEmpty()) return results;
        Request req = requests[0];

        Integer targetYear   = (req.year != null) ? req.year : Date.today().year();
        Integer targetQuarter = req.quarter; // if null → full year
        Integer maxLimit     = (req.limit != null && req.limit > 0) ? req.limit : 5;

        Date startDate;
        Date endDate;

        if (targetQuarter != null) {
            if (targetQuarter == 1) {
                startDate = Date.newInstance(targetYear, 1, 1);
                endDate   = Date.newInstance(targetYear, 3, 31);
            } else if (targetQuarter == 2) {
                startDate = Date.newInstance(targetYear, 4, 1);
                endDate   = Date.newInstance(targetYear, 6, 30);
            } else if (targetQuarter == 3) {
                startDate = Date.newInstance(targetYear, 7, 1);
                endDate   = Date.newInstance(targetYear, 9, 30);
            } else if (targetQuarter == 4) {
                startDate = Date.newInstance(targetYear, 10, 1);
                endDate   = Date.newInstance(targetYear, 12, 31);
            }
        } else {
            startDate = Date.newInstance(targetYear, 1, 1);
            endDate   = Date.newInstance(targetYear, 12, 31);
        }

        // Aggregate query against your Data Lake Object
        List<AggregateResult> aggResults = [
            SELECT CustomerName__c customer,
                   COUNT(Id) orders,
                   SUM(Revenue__c) revenue
            FROM Realistic_OrderLine_Datacsv__dlm
            WHERE OrderCreateDate__c >= :startDate
              AND OrderCreateDate__c <= :endDate
            GROUP BY CustomerName__c
            ORDER BY SUM(Revenue__c) DESC
            LIMIT :maxLimit
        ];

        for (AggregateResult ar : aggResults) {
            Result r = new Result();
            r.customer = (String) ar.get('customer');
            r.orders   = (Integer) ar.get('orders');
            r.revenue  = (Decimal) ar.get('revenue');
            results.add(r);
        }
        return results;
    }
}

// Create a request for Q1 2025
Customer_TopRevenueAction.Request req1 = new Customer_TopRevenueAction.Request();
req1.year = 2025;
req1.quarter = 1;
req1.limit = 5;

List<Customer_TopRevenueAction.Request> reqs1 = new List<Customer_TopRevenueAction.Request>{ req1 };
List<Customer_TopRevenueAction.Result> results1 = Customer_TopRevenueAction.run(reqs1);

System.debug('### Top 5 Customers in Q1 2025 ###');
for (Customer_TopRevenueAction.Result r : results1) {
    System.debug(r.customer + ' | Orders: ' + r.orders + ' | Revenue: ' + r.revenue);
}

// Create a request for full year 2025
Customer_TopRevenueAction.Request req2 = new Customer_TopRevenueAction.Request();
req2.year = 2025;
req2.limit = 5;

List<Customer_TopRevenueAction.Request> reqs2 = new List<Customer_TopRevenueAction.Request>{ req2 };
List<Customer_TopRevenueAction.Result> results2 = Customer_TopRevenueAction.run(reqs2);

System.debug('### Top 5 Customers in Full Year 2025 ###');
for (Customer_TopRevenueAction.Result r : results2) {
    System.debug(r.customer + ' | Orders: ' + r.orders + ' | Revenue: ' + r.revenue);
}

}
