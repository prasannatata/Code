public with sharing class Customer_TopRevenueAction {
    public class Result {
        @InvocableVariable public String customer;
        @InvocableVariable public String parentCustomer;
        @InvocableVariable public Integer orders;
        @InvocableVariable public Decimal revenue;
        @InvocableVariable public String heading;
    }

    // No structured input → agent passes parameters dynamically
    @InvocableMethod(label='Get Top Customers by Revenue')
    public static List<Result> run(List<String> inputs) {
        List<Result> outputs = new List<Result>();

        if (inputs == null || inputs.isEmpty()) return outputs;

        // Parse input (e.g. "year=2025,quarter=1,limit=5")
        String raw = inputs[0];
        Integer year = Date.today().year();
        Integer quarter;
        Integer limitSize = 10;

        if (raw.contains('year=')) {
            year = Integer.valueOf(raw.substringAfter('year=').substringBefore(',')); 
        }
        if (raw.contains('quarter=')) {
            quarter = Integer.valueOf(raw.substringAfter('quarter=').substringBefore(',')); 
        }
        if (raw.contains('limit=')) {
            limitSize = Integer.valueOf(raw.substringAfter('limit=').substringBefore(',')); 
        }

        // Build query
        String soql = 'SELECT CustomerName__c, ParentCustomerName__c, ' +
                      'COUNT(Id) totalOrders, SUM(Revenue__c) totalRevenue ' +
                      'FROM Realistic_OrderLine_Datacsv__dlm ' +
                      'WHERE CALENDAR_YEAR(OrderCreateDate__c) = :year ';

        if (quarter != null) {
            soql += 'AND CALENDAR_QUARTER(OrderCreateDate__c) = :quarter ';
        }

        soql += 'GROUP BY CustomerName__c, ParentCustomerName__c ' +
                'ORDER BY SUM(Revenue__c) DESC NULLS LAST ' +
                'LIMIT :limitSize';

        List<AggregateResult> ars = Database.query(soql);

        for (AggregateResult ar : ars) {
            Result r = new Result();
            r.customer = (String)ar.get('CustomerName__c');
            r.parentCustomer = (String)ar.get('ParentCustomerName__c');
            r.orders = (Integer)ar.get('totalOrders');
            r.revenue = (Decimal)ar.get('totalRevenue');
            r.heading = 'Top ' + limitSize + ' customers in ' +
                        ((quarter != null) ? 'Q' + quarter + ' ' : 'Year ') + year;
            outputs.add(r);
        }

        return outputs;
    }
}


// Build input string in "year=YYYY,quarter=N,limit=M" format
List<String> inputs = new List<String>();

// Example 1: Top 5 customers in Q1 2025
inputs.add('year=2025,quarter=1,limit=5');
List<Customer_TopRevenueAction.Result> q1Results =
    Customer_TopRevenueAction.run(inputs);
System.debug('=== Top 5 Customers in Q1 2025 ===');
System.debug(JSON.serializePretty(q1Results));

// Example 2: Top 10 customers for full year 2025
inputs.clear();
inputs.add('year=2025,limit=10');
List<Customer_TopRevenueAction.Result> yearResults =
    Customer_TopRevenueAction.run(inputs);
System.debug('=== Top 10 Customers in 2025 ===');
System.debug(JSON.serializePretty(yearResults));

// Example 3: Default (no quarter, no limit → will fallback to 10)
inputs.clear();
inputs.add('year=2024');
List<Customer_TopRevenueAction.Result> defaultResults =
    Customer_TopRevenueAction.run(inputs);
System.debug('=== Default Top 10 Customers in 2024 ===');
System.debug(JSON.serializePretty(defaultResults));


