public with sharing class Customer_TopRevenueAction {
    
    @InvocableMethod(label='Get Top Customers by Revenue')
    public static List<Result> run(List<Request> requests) {
        List<Result> results = new List<Result>();
        
        for (Request req : requests) {
            Integer yearVal = (req.year != null) ? req.year : Date.today().year();
            Integer quarterVal = req.quarter;
            Integer limitVal = (req.limit != null) ? req.limit : 5;
            
            // Build SOQL dynamically
            String soql = 'SELECT CustomerName__c customer, COUNT(Id) orders, SUM(Revenue__c) revenue ' +
                          'FROM Order__c ' +
                          'WHERE CALENDAR_YEAR(OrderDate__c) = :yearVal ';
            
            if (quarterVal != null) {
                soql += 'AND CALENDAR_QUARTER(OrderDate__c) = :quarterVal ';
            }
            
            soql += 'GROUP BY CustomerName__c ' +
                    'ORDER BY revenue DESC ' +
                    'LIMIT :limitVal';
            
            List<AggregateResult> aggResults = Database.query(soql);
            
            for (AggregateResult ar : aggResults) {
                results.add(new Result(
                    (String)ar.get('customer'),
                    (Integer)ar.get('orders'),
                    (Decimal)ar.get('revenue')
                ));
            }
        }
        return results;
    }
    
    public class Request {
        @InvocableVariable(label='Year') public Integer year;
        @InvocableVariable(label='Quarter') public Integer quarter;
        @InvocableVariable(label='Limit') public Integer limit;
    }
    
    public class Result {
        @InvocableVariable(label='Customer') public String customer;
        @InvocableVariable(label='Orders') public Integer orders;
        @InvocableVariable(label='Total Revenue') public Decimal revenue;
        
        public Result(String c, Integer o, Decimal r) {
            customer = c;
            orders = o;
            revenue = r;
        }
    }
}

// Example 1: Get top 5 customers for Q1 2025
List<Customer_TopRevenueAction.Request> reqs1 = new List<Customer_TopRevenueAction.Request>();
Customer_TopRevenueAction.Request r1 = new Customer_TopRevenueAction.Request();
r1.year = 2025;
r1.quarter = 1;
r1.limit = 5;
reqs1.add(r1);

List<Customer_TopRevenueAction.Result> res1 = Customer_TopRevenueAction.run(reqs1);
System.debug('### Top 5 Customers in Q1 2025 ###');
for (Customer_TopRevenueAction.Result r : res1) {
    System.debug(r.customer + ' | Orders: ' + r.orders + ' | Revenue: ' + r.revenue);
}

