public with sharing class Customer_TopRevenueAction {
    public class Request {
        @InvocableVariable(required=false)
        public Integer limitSize;
    }

    public class Response {
        @InvocableVariable
        public String result;
    }

    @InvocableMethod(label='Top Revenue Customers' description='List top customers by revenue')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();

        for (Request r : reqs) {
            Response res = new Response();
            Integer limitValue = (r.limitSize != null && r.limitSize > 0) ? r.limitSize : 10;

            // ✅ Explicit aliasing
            String query =
                'SELECT CustomerName__c, SUM(Revenue__c) totalRevenue, COUNT(Id) orderCount ' +
                'FROM Realistic_OrderLine_Datacsv__dlm ' +
                'GROUP BY CustomerName__c ' +
                'ORDER BY totalRevenue DESC ' +
                'LIMIT ' + limitValue;

            List<AggregateResult> rows = Database.query(query);

            if (rows.isEmpty()) {
                res.result = '❌ No customer revenue data found.';
            } else {
                String table = 'Customer | Orders | Total Revenue\n';
                table += '---|---|---\n';

                for (AggregateResult ar : rows) {
                    String custName = (String)ar.get('CustomerName__c');
                    String orderCount = String.valueOf(ar.get('orderCount'));
                    String revenue = String.valueOf(ar.get('totalRevenue'));

                    table += custName + ' | ' + orderCount + ' | $' + revenue + '\n';
                }

                res.result = table;
            }

            results.add(res);
        }

        return results;
    }
}

List<Customer_TopRevenueAction.Request> reqs = new List<Customer_TopRevenueAction.Request>();

Customer_TopRevenueAction.Request r = new Customer_TopRevenueAction.Request();
r.limitSize = 5; // top 5 customers
reqs.add(r);

List<Customer_TopRevenueAction.Response> res = Customer_TopRevenueAction.run(reqs);

System.debug('>>> Top Revenue Customers:\n' + res[0].result);
