public with sharing class Customer_TopRevenueAction {

    // Request wrapper
    public class Request {
        @InvocableVariable(label='Year') public Integer year;
        @InvocableVariable(label='Quarter') public Integer quarter;
        @InvocableVariable(label='Top N Customers') public Integer limitSize;
    }

    // Response wrapper
    public class Result {
        @InvocableVariable public String heading;   // for ONE record only
        @InvocableVariable public String customer;
        @InvocableVariable public Integer orders;
        @InvocableVariable public Decimal revenue;

        public Result(String heading, String cust, Integer ord, Decimal rev) {
            this.heading  = heading;
            this.customer = cust;
            this.orders   = ord;
            this.revenue  = rev;
        }
    }

    @InvocableMethod(label='Get Top Customers by Revenue')
    public static List<Result> run(List<Request> requests) {
        List<Result> results = new List<Result>();
        if (requests.isEmpty()) return results;

        Request req = requests[0];

        // Defaults
        Integer targetYear    = (req.year != null) ? req.year : Date.today().year();
        Integer targetQuarter = req.quarter; 
        Integer maxLimit      = (req.limitSize != null && req.limitSize > 0) ? req.limitSize : 5;

        Date startDate;
        Date endDate;

        // Quarter-specific or full year
        if (targetQuarter != null) {
            if (targetQuarter == 1) {
                startDate = Date.newInstance(targetYear, 1, 1);
                endDate   = Date.newInstance(targetYear, 3, 31);
            } else if (targetQuarter == 2) {
                startDate = Date.newInstance(targetYear, 4, 1);
                endDate   = Date.newInstance(targetYear, 6, 30);
            } else if (targetQuarter == 3) {
                startDate = Date.newInstance(targetYear, 7, 1);
                endDate   = Date.newInstance(targetYear, 9, 30);
            } else if (targetQuarter == 4) {
                startDate = Date.newInstance(targetYear, 10, 1);
                endDate   = Date.newInstance(targetYear, 12, 31);
            }
        } else {
            startDate = Date.newInstance(targetYear, 1, 1);
            endDate   = Date.newInstance(targetYear, 12, 31);
        }

        // Dynamic heading
        String heading;
        if (targetQuarter != null) {
            heading = 'Top ' + maxLimit + ' customers in Q' + targetQuarter + ' ' + targetYear;
        } else {
            heading = 'Top ' + maxLimit + ' customers in Year ' + targetYear;
        }

        // Query top N customers
        List<AggregateResult> aggResults = [
            SELECT CustomerName__c cust,
                   COUNT(Id) orders,
                   SUM(Revenue__c) totalRevenue
            FROM Realistic_OrderLine_Datacsv__dlm
            WHERE OrderCreateDate__c >= :startDate
              AND OrderCreateDate__c <= :endDate
            GROUP BY CustomerName__c
            ORDER BY SUM(Revenue__c) DESC
            LIMIT :maxLimit
        ];

        // Add heading only for the FIRST row
        Boolean isFirst = true;
        for (AggregateResult ar : aggResults) {
            results.add(new Result(
                isFirst ? heading : null,   // only first row has heading
                (String)ar.get('cust'),
                (Integer)ar.get('orders'),
                (Decimal)ar.get('totalRevenue')
            ));
            isFirst = false;
        }

        return results;
    }
}




// Example 1: Top 5 customers in current year
List<Customer_TopRevenueAction.Request> reqs = new List<Customer_TopRevenueAction.Request>();
Customer_TopRevenueAction.Request r = new Customer_TopRevenueAction.Request();
r.year = Date.today().year();
r.limitSize = 5;
reqs.add(r);

List<Customer_TopRevenueAction.Result> res = Customer_TopRevenueAction.run(reqs);
System.debug(res);

