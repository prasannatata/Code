public with sharing class Customer_RevenueDropOffAction {
    public class Request {
        @InvocableVariable(label='Number of Top Customers')
        public Integer topN = 20;
    }
    
    public class Response {
        @InvocableVariable(label='Result')
        public String result;
    }
    
    @InvocableMethod(label='Detect Revenue Drop-Off')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();
        
        for (Request r : reqs) {
            Response res = new Response();
            
            // Get current and previous quarter dates
            Date today = Date.today();
            Integer currentYear = today.year();
            Integer currentQuarter = ((today.month() - 1) / 3) + 1;
            
            // Previous quarter
            Integer prevQuarter = currentQuarter - 1;
            Integer prevYear = currentYear;
            if (prevQuarter == 0) {
                prevQuarter = 4;
                prevYear--;
            }
            
            Date currStart = Date.newInstance(currentYear, ((currentQuarter - 1) * 3) + 1, 1);
            Date currEnd = currStart.addMonths(3).addDays(-1);
            
            Date prevStart = Date.newInstance(prevYear, ((prevQuarter - 1) * 3) + 1, 1);
            Date prevEnd = prevStart.addMonths(3).addDays(-1);
            
            // Query current quarter
            List<AggregateResult> currResults = [
                SELECT CustomerName__c, SUM(Revenue__c) totalRev, SUM(Quantity__c) totalQty
                FROM Realistic_OrderLine_Datacsv__dlm
                WHERE OrderPODate__c >= :currStart AND OrderPODate__c <= :currEnd
                GROUP BY CustomerName__c
            ];
            
            // Query previous quarter
            List<AggregateResult> prevResults = [
                SELECT CustomerName__c, SUM(Revenue__c) totalRev, SUM(Quantity__c) totalQty
                FROM Realistic_OrderLine_Datacsv__dlm
                WHERE OrderPODate__c >= :prevStart AND OrderPODate__c <= :prevEnd
                GROUP BY CustomerName__c
            ];
            
            // Build maps
            Map<String, Decimal> currRevMap = new Map<String, Decimal>();
            Map<String, Decimal> prevRevMap = new Map<String, Decimal>();
            
            for (AggregateResult ar : currResults) {
                currRevMap.put((String)ar.get('CustomerName__c'), (Decimal)ar.get('totalRev'));
            }
            
            for (AggregateResult ar : prevResults) {
                prevRevMap.put((String)ar.get('CustomerName__c'), (Decimal)ar.get('totalRev'));
            }
            
            // Find drop-offs
            List<DropOffRecord> dropOffs = new List<DropOffRecord>();
            
            for (String customer : prevRevMap.keySet()) {
                Decimal prevRev = prevRevMap.get(customer);
                Decimal currRev = currRevMap.containsKey(customer) ? currRevMap.get(customer) : 0;
                
                if (currRev < prevRev) {
                    DropOffRecord rec = new DropOffRecord();
                    rec.customerName = customer;
                    rec.prevRevenue = prevRev;
                    rec.currRevenue = currRev;
                    rec.dropAmount = prevRev - currRev;
                    rec.dropPercent = ((prevRev - currRev) / prevRev) * 100;
                    dropOffs.add(rec);
                }
            }
            
            // Sort by drop amount
            dropOffs.sort();
            
            if (dropOffs.isEmpty()) {
                res.result = 'No revenue drop-offs detected between Q' + prevQuarter + ' ' + prevYear + 
                           ' and Q' + currentQuarter + ' ' + currentYear;
            } else {
                Integer displayCount = Math.min(r.topN, dropOffs.size());
                String table = 'Revenue Drop-Off: Q' + prevQuarter + ' ' + prevYear + 
                             ' → Q' + currentQuarter + ' ' + currentYear + '\n\n';
                table += 'Customer | Previous Rev | Current Rev | Drop Amount | Drop %\n';
                table += '--- | --- | --- | --- | ---\n';
                
                for (Integer i = 0; i < displayCount; i++) {
                    DropOffRecord rec = dropOffs[i];
                    table += rec.customerName + ' | $' + rec.prevRevenue.setScale(2) + ' | $' + 
                           rec.currRevenue.setScale(2) + ' | $' + rec.dropAmount.setScale(2) + 
                           ' | ' + rec.dropPercent.setScale(1) + '%\n';
                }
                
                res.result = table;
            }
            
            results.add(res);
        }
        
        return results;
    }
    
    private class DropOffRecord implements Comparable {
        public String customerName;
        public Decimal prevRevenue;
        public Decimal currRevenue;
        public Decimal dropAmount;
        public Decimal dropPercent;
        
        public Integer compareTo(Object other) {
            DropOffRecord otherRec = (DropOffRecord)other;
            if (dropAmount > otherRec.dropAmount) return -1;
            if (dropAmount < otherRec.dropAmount) return 1;
            return 0;
        }
    }
}
// Test Revenue Drop-Off Action
Customer_RevenueDropOffAction.Request req = new Customer_RevenueDropOffAction.Request();
req.topN = 10; // Show top 10 customers with drop-off

List<Customer_RevenueDropOffAction.Request> requests = new List<Customer_RevenueDropOffAction.Request>{req};
List<Customer_RevenueDropOffAction.Response> responses = Customer_RevenueDropOffAction.run(requests);

System.debug('===== REVENUE DROP-OFF RESULTS =====');
System.debug(responses[0].result);


