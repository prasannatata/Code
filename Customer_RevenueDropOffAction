public with sharing class Customer_RevenueDropOffAction {
    public class Request {
        @InvocableVariable(label='Period 1 Start Date (earlier period)')
        public Date period1Start;
        
        @InvocableVariable(label='Period 1 End Date')
        public Date period1End;
        
        @InvocableVariable(label='Period 2 Start Date (later period)')
        public Date period2Start;
        
        @InvocableVariable(label='Period 2 End Date')
        public Date period2End;
        
        @InvocableVariable(label='Number of Top Customers')
        public Integer topN = 20;
    }
    
    public class Response {
        @InvocableVariable(label='Result')
        public String result;
    }
    
    @InvocableMethod(label='Detect Revenue Drop-Off')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();
        
        for (Request r : reqs) {
            Response res = new Response();
            
            // If dates not provided, default to current quarter vs previous quarter
            Date period1Start, period1End, period2Start, period2End;
            String period1Label, period2Label;
            
            if (r.period1Start == null || r.period2Start == null) {
                // Default: compare current quarter vs previous quarter
                Date today = Date.today();
                Integer currentYear = today.year();
                Integer currentQuarter = ((today.month() - 1) / 3) + 1;
                
                Integer prevQuarter = currentQuarter - 1;
                Integer prevYear = currentYear;
                if (prevQuarter == 0) {
                    prevQuarter = 4;
                    prevYear--;
                }
                
                period1Start = Date.newInstance(prevYear, ((prevQuarter - 1) * 3) + 1, 1);
                period1End = period1Start.addMonths(3).addDays(-1);
                period2Start = Date.newInstance(currentYear, ((currentQuarter - 1) * 3) + 1, 1);
                period2End = period2Start.addMonths(3).addDays(-1);
                
                period1Label = 'Q' + prevQuarter + ' ' + prevYear;
                period2Label = 'Q' + currentQuarter + ' ' + currentYear;
            } else {
                // Use provided dates
                period1Start = r.period1Start;
                period1End = r.period1End;
                period2Start = r.period2Start;
                period2End = r.period2End;
                
                period1Label = period1Start.format() + ' to ' + period1End.format();
                period2Label = period2Start.format() + ' to ' + period2End.format();
            }
            
            // Query period 1 (earlier/baseline period)
            List<AggregateResult> period1Results = [
                SELECT CustomerName__c, SUM(Revenue__c) totalRev, SUM(Quantity__c) totalQty
                FROM Realistic_OrderLine_Datacsv__dlm
                WHERE OrderPODate__c >= :period1Start AND OrderPODate__c <= :period1End
                GROUP BY CustomerName__c
            ];
            
            // Query period 2 (later/comparison period)
            List<AggregateResult> period2Results = [
                SELECT CustomerName__c, SUM(Revenue__c) totalRev, SUM(Quantity__c) totalQty
                FROM Realistic_OrderLine_Datacsv__dlm
                WHERE OrderPODate__c >= :period2Start AND OrderPODate__c <= :period2End
                GROUP BY CustomerName__c
            ];
            
            // Build maps
            Map<String, Decimal> period1RevMap = new Map<String, Decimal>();
            Map<String, Decimal> period2RevMap = new Map<String, Decimal>();
            
            for (AggregateResult ar : period1Results) {
                period1RevMap.put((String)ar.get('CustomerName__c'), (Decimal)ar.get('totalRev'));
            }
            
            for (AggregateResult ar : period2Results) {
                period2RevMap.put((String)ar.get('CustomerName__c'), (Decimal)ar.get('totalRev'));
            }
            
            // Find drop-offs (customers who had revenue in period 1 but less/none in period 2)
            List<DropOffRecord> dropOffs = new List<DropOffRecord>();
            
            for (String customer : period1RevMap.keySet()) {
                Decimal period1Rev = period1RevMap.get(customer);
                Decimal period2Rev = period2RevMap.containsKey(customer) ? period2RevMap.get(customer) : 0;
                
                if (period2Rev < period1Rev) {
                    DropOffRecord rec = new DropOffRecord();
                    rec.customerName = customer;
                    rec.period1Revenue = period1Rev;
                    rec.period2Revenue = period2Rev;
                    rec.dropAmount = period1Rev - period2Rev;
                    rec.dropPercent = ((period1Rev - period2Rev) / period1Rev) * 100;
                    dropOffs.add(rec);
                }
            }
            
            // Sort by drop amount (largest drops first)
            dropOffs.sort();
            
            if (dropOffs.isEmpty()) {
                res.result = 'No revenue drop-offs detected between ' + period1Label + ' and ' + period2Label;
            } else {
                Integer displayCount = Math.min(r.topN, dropOffs.size());
                String table = 'Revenue Drop-Off Analysis: ' + period1Label + ' → ' + period2Label + '\n\n';
                table += 'Customer | ' + period1Label + ' | ' + period2Label + ' | Drop Amount | Drop %\n';
                table += '--- | --- | --- | --- | ---\n';
                
                for (Integer i = 0; i < displayCount; i++) {
                    DropOffRecord rec = dropOffs[i];
                    table += rec.customerName + ' | $' + rec.period1Revenue.setScale(2) + ' | $' + 
                           rec.period2Revenue.setScale(2) + ' | $' + rec.dropAmount.setScale(2) + 
                           ' | ' + rec.dropPercent.setScale(1) + '%\n';
                }
                
                res.result = table;
            }
            
            results.add(res);
        }
        
        return results;
    }
    
    private class DropOffRecord implements Comparable {
        public String customerName;
        public Decimal period1Revenue;
        public Decimal period2Revenue;
        public Decimal dropAmount;
        public Decimal dropPercent;
        
        public Integer compareTo(Object other) {
            DropOffRecord otherRec = (DropOffRecord)other;
            if (dropAmount > otherRec.dropAmount) return -1;
            if (dropAmount < otherRec.dropAmount) return 1;
            return 0;
        }
    }
}




