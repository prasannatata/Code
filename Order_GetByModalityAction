public with sharing class Order_GetByModalityAction {

    public class Request {
        @InvocableVariable(label='Modality Filter (Optional)')
        public String modalityName;
    }

    public class Response {
        @InvocableVariable(label='Result')
        public String result;
    }

    @InvocableMethod(label='Get Orders By Modality')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();

        for (Request r : reqs) {
            Response res = new Response();
            List<Realistic_OrderLine_Datacsv__dlm> rows;

            // Apply filter if modality specified
            if (String.isNotBlank(r.modalityName)) {
                rows = [
                    SELECT Modality__c, Quantity__c, Revenue__c
                    FROM Realistic_OrderLine_Datacsv__dlm
                    WHERE Modality__c = :r.modalityName
                ];
            } else {
                rows = [
                    SELECT Modality__c, Quantity__c, Revenue__c
                    FROM Realistic_OrderLine_Datacsv__dlm
                ];
            }

            if (rows.isEmpty()) {
                res.result = (String.isNotBlank(r.modalityName))
                    ? '❌ No orders found for modality ' + r.modalityName
                    : '❌ No modality data found.';
            } else {
                // Rollup by Modality
                Map<String, OrderDL_Util.Tot> totals = OrderDL_Util.rollup(rows, 'Modality');
                res.result = OrderDL_Util.fmtRollupTable(totals, 'Modality Performance', 'Modality');
            }

            results.add(res);
        }

        return results;
    }
}

