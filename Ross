public with sharing class Customer_TopRevenueAction {
    
    public class Request {
        @InvocableVariable(label='Year' required=false)
        public Integer year;
        
        @InvocableVariable(label='Quarter (1-4)' required=false)
        public Integer quarter;
        
        @InvocableVariable(label='Limit' required=false)
        public Integer limitSize;
        
        @InvocableVariable(label='Minimum Revenue' required=false)
        public Decimal minRevenue;
        
        @InvocableVariable(label='Customer Name Filter' required=false)
        public String customerNameFilter;
    }
    
    public class Result {
        @InvocableVariable(label='Result JSON')
        public String resultJson;
        
        @InvocableVariable(label='Heading')
        public String heading;
        
        @InvocableVariable(label='Error Message')
        public String errorMessage;
    }
    
    @InvocableMethod(
        label='Get Top Customers by Revenue' 
        description='Returns top customers by revenue with flexible filtering'
    )
    public static List<Result> run(List<Request> requests) {
        List<Result> outputs = new List<Result>();
        Result res = new Result();
        
        try {
            if (requests == null || requests.isEmpty()) {
                res.errorMessage = 'No request provided.';
                outputs.add(res);
                return outputs;
            }
            
            Request req = requests[0];
            
            Integer year = (req.year != null) ? req.year : Date.today().year();
            Integer quarter = req.quarter;
            Integer limitSize = (req.limitSize != null && req.limitSize > 0) ? req.limitSize : 10;
            Decimal minRevenue = req.minRevenue;
            String customerFilter = req.customerNameFilter;
            
            // Date range
            Date startDate = Date.newInstance(year, 1, 1);
            Date endDate = Date.newInstance(year, 12, 31);
            
            if (quarter != null) {
                Integer startMonth = (quarter - 1) * 3 + 1;
                Integer endMonth = startMonth + 2;
                startDate = Date.newInstance(year, startMonth, 1);
                endDate = Date.newInstance(year, endMonth, Date.daysInMonth(year, endMonth));
            }
            
            // Build query
            String soql = buildQuery(startDate, endDate, limitSize, minRevenue, customerFilter);
            System.debug('Executing SOQL: ' + soql);
            
            List<AggregateResult> ars = Database.query(soql);
            
            // Convert results into JSON list
            List<Map<String, Object>> jsonResults = new List<Map<String, Object>>();
            for (AggregateResult ar : ars) {
                Map<String, Object> row = new Map<String, Object>();
                row.put('Customer', (String)ar.get('CustomerName__c'));
                row.put('ParentCustomer', (String)ar.get('ParentCustomerName__c'));
                row.put('Orders', (Integer)ar.get('totalOrders'));
                row.put('Revenue', (Decimal)ar.get('totalRevenue'));
                jsonResults.add(row);
            }
            
            res.resultJson = JSON.serializePretty(jsonResults);
            res.heading = buildHeading(year, quarter, limitSize);
            
            if (jsonResults.isEmpty()) {
                res.errorMessage = 'No data found for the specified criteria.';
            }
            
        } catch (Exception e) {
            res.errorMessage = 'Error: ' + e.getMessage();
        }
        
        outputs.add(res);
        return outputs;
    }
    
    // Build SOQL query
    private static String buildQuery(
        Date startDate,
        Date endDate,
        Integer limitSize,
        Decimal minRevenue,
        String customerFilter
    ) {
        String soql = 
            'SELECT CustomerName__c, ParentCustomerName__c, ' +
            'COUNT(Id) totalOrders, ' +
            'SUM(Revenue__c) totalRevenue ' +
            'FROM Realistic_OrderLine_Datacsv__dlm ' +
            'WHERE OrderCreateDate__c >= :startDate ' +
            'AND OrderCreateDate__c <= :endDate ';
        
        if (String.isNotBlank(customerFilter)) {
            String filterPattern = '%' + customerFilter + '%';
            soql += 'AND CustomerName__c LIKE :filterPattern ';
        }
        
        soql += 'GROUP BY CustomerName__c, ParentCustomerName__c ';
        
        if (minRevenue != null && minRevenue > 0) {
            soql += 'HAVING SUM(Revenue__c) >= :minRevenue ';
        }
        
        soql += 'ORDER BY SUM(Revenue__c) DESC NULLS LAST ' +
                'LIMIT :limitSize';
        
        return soql;
    }
    
    // Heading
    private static String buildHeading(Integer year, Integer quarter, Integer limitSize) {
        String heading = 'Top ' + limitSize + ' customers by revenue in ';
        if (quarter != null) heading += 'Q' + quarter + ' ';
        heading += year;
        return heading;
    }
}


// Build request
Customer_TopRevenueAction.Request req = new Customer_TopRevenueAction.Request();
req.year = 2025;                // test year
req.quarter = 1;                // Q1
req.limitSize = 5;              // top 5 customers
req.minRevenue = 1000;          // optional filter
req.customerNameFilter = null;  // no name filter

// Call the Apex action
List<Customer_TopRevenueAction.Request> reqs = new List<Customer_TopRevenueAction.Request>{ req };
List<Customer_TopRevenueAction.Result> results = Customer_TopRevenueAction.run(reqs);

// Print outputs
for (Customer_TopRevenueAction.Result res : results) {
    System.debug('--- TEST RESULT ---');
    System.debug('Heading: ' + res.heading);
    System.debug('Result JSON: ' + res.resultJson);
    System.debug('Error: ' + res.errorMessage);
}
