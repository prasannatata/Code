public with sharing class CustomerTopRevenueAction {

    @InvocableMethod(label='Get Top Revenue Customers')
    public static List<RevenueRecord__c> getTopRevenueCustomers(List<Id> accountIds) {
        List<RevenueRecord__c> results = new List<RevenueRecord__c>();

        try {
            // Query Accounts with revenue-related fields
            // 🔑 Update field API names to match your org schema
            List<Account> accList = [
                SELECT Id, Name, ParentId, 
                       AnnualRevenue, 
                       NumberOfOrders__c   // <-- Check if this field exists
                FROM Account
                WHERE Id IN :accountIds
            ];

            // Transform into Revenue Records (not inserting!)
            for (Account acc : accList) {
                RevenueRecord__c rec = new RevenueRecord__c();
                rec.CustomerName__c = acc.Name;
                rec.ParentCustomerName__c = (acc.ParentId != null) 
                                               ? acc.Parent.Name 
                                               : 'N/A';
                rec.Revenue__c = (acc.AnnualRevenue != null) 
                                               ? acc.AnnualRevenue 
                                               : 0;
                rec.NumberOfOrders__c = (acc.NumberOfOrders__c != null) 
                                               ? acc.NumberOfOrders__c 
                                               : 0;
                results.add(rec);
            }

        } catch (Exception e) {
            System.debug('⚠️ Error in getTopRevenueCustomers: ' + e.getMessage());
        }

        return results;
    }
}
