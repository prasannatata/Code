public with sharing class RevenueHelper {

    // Wrapper to match your Agent Action schema
    public class RevenueRecord {
        @AuraEnabled public String customer { get; set; }
        @AuraEnabled public String parentCustomer { get; set; }
        @AuraEnabled public Integer orders { get; set; }
        @AuraEnabled public Decimal revenue { get; set; }
        @AuraEnabled public String heading { get; set; }
    }

    @AuraEnabled(cacheable=true)
    public static List<RevenueRecord> getTopRevenueCustomers(Integer yearValue) {
        List<RevenueRecord> results = new List<RevenueRecord>();

        try {
            // Query Accounts with AnnualRevenue (adjust object/fields as needed)
            List<Account> accList = [
                SELECT Id, Name, Parent.Name, AnnualRevenue, NumberOfOrders__c
                FROM Account
                WHERE CALENDAR_YEAR(CreatedDate) = :yearValue
                ORDER BY AnnualRevenue DESC
                LIMIT 5
            ];

            // Build response list
            for (Account acc : accList) {
                RevenueRecord rec = new RevenueRecord();
                rec.customer       = acc.Name;
                rec.parentCustomer = (acc.Parent != null) ? acc.Parent.Name : null;
                rec.orders         = (acc.NumberOfOrders__c != null) ? Integer.valueOf(acc.NumberOfOrders__c) : 0;
                rec.revenue        = (acc.AnnualRevenue != null) ? acc.AnnualRevenue : 0;
                rec.heading        = 'Top 5 customers by revenue in ' + yearValue;
                results.add(rec);
            }

        } catch (Exception e) {
            System.debug('⚠️ Error in getTopRevenueCustomers: ' + e.getMessage());
            // Return empty list instead of throwing error
        }

        return results;
    }
}
