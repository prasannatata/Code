public with sharing class RevenueHelper {

    // Wrapper for Agent Action output
    public class RevenueRecord {
        @AuraEnabled public String customer { get; set; }
        @AuraEnabled public String parentCustomer { get; set; }
        @AuraEnabled public Integer orders { get; set; }
        @AuraEnabled public Decimal revenue { get; set; }
        @AuraEnabled public String heading { get; set; }
    }

    @AuraEnabled(cacheable=true)
    public static List<RevenueRecord> getTopRevenueCustomers(Integer yearValue) {
        List<RevenueRecord> results = new List<RevenueRecord>();

        try {
            // Query Data Cloud object instead of Account
            List<Realistic_OrderLine_Datacsv__dlm> orderLines = [
                SELECT CustomerName__c,
                       ParentCustomerName__c,
                       Revenue__c,
                       OrderRefNumber__c,
                       OrderCreateDate__c
                FROM Realistic_OrderLine_Datacsv__dlm
                WHERE CALENDAR_YEAR(OrderCreateDate__c) = :yearValue
                ORDER BY Revenue__c DESC
                LIMIT 5
            ];

            for (Realistic_OrderLine_Datacsv__dlm ol : orderLines) {
                RevenueRecord rec = new RevenueRecord();
                rec.customer       = ol.CustomerName__c;
                rec.parentCustomer = ol.ParentCustomerName__c;
                rec.orders         = 1; // Default: 1 order per row (aggregate logic can be added later)
                rec.revenue        = (ol.Revenue__c != null) ? ol.Revenue__c : 0;
                rec.heading        = 'Top 5 customers by revenue in ' + yearValue;
                results.add(rec);
            }

        } catch (Exception e) {
            System.debug('⚠️ Error in getTopRevenueCustomers: ' + e.getMessage());
            return new List<RevenueRecord>(); // safe fallback
        }

        return results;
    }
}
