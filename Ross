public with sharing class Customer_TopRevenueAction {
    
    // Request object (inputs)
    public class Request {
        @InvocableVariable(label='Year' required=false)
        public Integer year;
        
        @InvocableVariable(label='Quarter (1-4)' required=false)
        public Integer quarter;
        
        @InvocableVariable(label='Limit' required=false)
        public Integer limitSize;
        
        @InvocableVariable(label='Minimum Revenue' required=false)
        public Decimal minRevenue;
        
        @InvocableVariable(label='Customer Name Filter' required=false)
        public String customerNameFilter;
    }
    
    // Result object (outputs)
    public class Result {
        @InvocableVariable(label='Customer Name')
        public String customer;
        
        @InvocableVariable(label='Parent Customer')
        public String parentCustomer;
        
        @InvocableVariable(label='Total Orders')
        public Integer orders;
        
        @InvocableVariable(label='Total Revenue')
        public Decimal revenue;
        
        @InvocableVariable(label='Heading')
        public String heading;
    }
    
    // Main method
    @InvocableMethod(
        label='Get Top Customers by Revenue' 
        description='Returns top customers by revenue with flexible filtering'
    )
    public static List<Result> run(List<Request> requests) {
        List<Result> outputs = new List<Result>();
        
        if (requests == null || requests.isEmpty()) {
            return outputs;
        }
        
        Request req = requests[0];
        
        // defaults
        Integer year = (req.year != null) ? req.year : Date.today().year();
        Integer quarter = req.quarter;
        Integer limitSize = (req.limitSize != null && req.limitSize > 0) ? req.limitSize : 5;
        Decimal minRevenue = req.minRevenue;
        String customerFilter = req.customerNameFilter;
        
        // validate quarter
        if (quarter != null && (quarter < 1 || quarter > 4)) {
            return new List<Result>{ makeError('Invalid quarter: ' + quarter) };
        }
        
        // validate year
        if (year < 1900 || year > 2100) {
            return new List<Result>{ makeError('Invalid year: ' + year) };
        }
        
        // date range
        Date startDate = Date.newInstance(year, 1, 1);
        Date endDate = Date.newInstance(year, 12, 31);
        
        if (quarter != null) {
            Integer startMonth = (quarter - 1) * 3 + 1;
            Integer endMonth = startMonth + 2;
            Integer lastDay = Date.daysInMonth(year, endMonth);
            
            startDate = Date.newInstance(year, startMonth, 1);
            endDate = Date.newInstance(year, endMonth, lastDay);
        }
        
        // build SOQL
        String soql = buildQuery(startDate, endDate, limitSize, minRevenue, customerFilter);
        System.debug('Executing SOQL: ' + soql);
        
        List<AggregateResult> ars = Database.query(soql);
        
        String heading = buildHeading(year, quarter, limitSize);
        
        for (AggregateResult ar : ars) {
            Result r = new Result();
            r.customer = (String)ar.get('CustomerName__c');
            r.parentCustomer = (String)ar.get('ParentCustomerName__c');
            r.orders = (Integer)ar.get('totalOrders');
            r.revenue = (Decimal)ar.get('totalRevenue');
            r.heading = heading;
            outputs.add(r);
        }
        
        if (outputs.isEmpty()) {
            return new List<Result>{ makeError('No data found for the specified criteria.') };
        }
        
        return outputs;
    }
    
    // helper to build query
    private static String buildQuery(
        Date startDate,
        Date endDate,
        Integer limitSize,
        Decimal minRevenue,
        String customerFilter
    ) {
        String soql = 
            'SELECT CustomerName__c, ParentCustomerName__c, ' +
            'COUNT(Id) totalOrders, ' +
            'SUM(Revenue__c) totalRevenue ' +
            'FROM Realistic_OrderLine_Datacsv__dlm ' +
            'WHERE OrderCreateDate__c >= :startDate ' +
            'AND OrderCreateDate__c <= :endDate ';
        
        if (String.isNotBlank(customerFilter)) {
            String filterPattern = '%' + customerFilter + '%';
            soql += 'AND CustomerName__c LIKE :filterPattern ';
        }
        
        soql += 'GROUP BY CustomerName__c, ParentCustomerName__c ';
        
        if (minRevenue != null && minRevenue > 0) {
            soql += 'HAVING SUM(Revenue__c) >= :minRevenue ';
        }
        
        soql += 'ORDER BY SUM(Revenue__c) DESC NULLS LAST ' +
                'LIMIT :limitSize';
        
        return soql;
    }
    
    // helper to build heading
    private static String buildHeading(Integer year, Integer quarter, Integer limitSize) {
        String heading = 'Top ' + limitSize + ' customers by revenue in ';
        if (quarter != null) {
            heading += 'Q' + quarter + ' ';
        }
        heading += year;
        return heading;
    }
    
    // helper for error
    private static Result makeError(String msg) {
        Result r = new Result();
        r.heading = msg;
        r.customer = '';
        r.parentCustomer = '';
        r.orders = 0;
        r.revenue = 0;
        return r;
    }
}
