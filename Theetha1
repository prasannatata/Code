## 📄 revenueDropOffTable.js

```js
import { LightningElement, api } from 'lwc';

export default class RevenueDropOffTable extends LightningElement {

    @api value; // This will receive List<DropOffWrapper> from Agentforce

    columns = [
        { label: 'Customer Name', fieldName: 'customerName' },
        { label: 'Period 1 Revenue', fieldName: 'period1Revenue' },
        { label: 'Period 2 Revenue', fieldName: 'period2Revenue' },
        { label: 'Drop Amount', fieldName: 'dropAmount' },
        { label: 'Drop %', fieldName: 'dropPercentage' }
    ];

    get records() {
        let rows = [];

        if (this.value && Array.isArray(this.value)) {
            for (const element of this.value) {
                rows.push({
                    customerName: element.customerName,
                    period1Revenue: element.period1Revenue,
                    period2Revenue: element.period2Revenue,
                    dropAmount: element.dropAmount,
                    dropPercentage: element.dropPercentage
                });
            }
        }

        return rows;
    }
}
```

