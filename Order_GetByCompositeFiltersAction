public with sharing class Order_GetByCompositeFiltersAction {

    // ===== Request DTO =====
    public class Request {
        @InvocableVariable(label='Order Status')
        public String status;

        @InvocableVariable(label='PO Date Before')
        public Date poDateBefore;

        @InvocableVariable(label='Requestor')
        public String requestor;

        @InvocableVariable(label='OEM Name')
        public String oemName;
    }

    // ===== Response DTO =====
    public class Response {
        @InvocableVariable(label='Result')
        public String result;
    }

    // ===== Invocable Method =====
    @InvocableMethod(label='Get Orders by Composite Filters')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();

        for (Request r : reqs) {
            Response res = new Response();

            // Base query
            String baseQuery = 
                'SELECT OrderRefNumber__c, CustomerName__c, OrderStatus__c, ' +
                       'Vendor__c, Modality__c, OEM__c, Quantity__c, Revenue__c, ' +
                       'OrderCreateDate__c, OrderPODate__c, Requestor__c ' +
                'FROM Realistic_OrderLine_Datacsv__dlm';

            List<String> filters = new List<String>();

            // === Apply filters dynamically ===
            if (!String.isBlank(r.status)) {
                filters.add('OrderStatus__c = \'' + String.escapeSingleQuotes(r.status) + '\'');
            }

            if (r.poDateBefore != null) {
                // ✅ Correct: no quotes for Date fields
                filters.add('OrderPODate__c < ' + r.poDateBefore.formatGmt('yyyy-MM-dd'));
            }

            if (!String.isBlank(r.requestor)) {
                filters.add('Requestor__c = \'' + String.escapeSingleQuotes(r.requestor) + '\'');
            }

            if (!String.isBlank(r.oemName)) {
                filters.add('OEM__c = \'' + String.escapeSingleQuotes(r.oemName) + '\'');
            }

            // Append WHERE if needed
            if (!filters.isEmpty()) {
                baseQuery += ' WHERE ' + String.join(filters, ' AND ');
            }

            // === Run the query ===
            List<Realistic_OrderLine_Datacsv__dlm> rows = Database.query(baseQuery);

            // === Handle Results ===
            if (rows.isEmpty()) {
                res.result = '❌ No matching orders found with given filters.';
            } else {
                res.result = OrderDL_Util.fmtOrdersTable(rows, 'Filtered Orders');
            }

            results.add(res);
        }
        return results;
    }
}
List<Order_GetByCompositeFiltersAction.Request> reqs = new List<Order_GetByCompositeFiltersAction.Request>();

Order_GetByCompositeFiltersAction.Request r = new Order_GetByCompositeFiltersAction.Request();
r.status = 'Pending';
r.poDateBefore = Date.newInstance(2025, 6, 1); // June 1, 2025
r.requestor = 'Jane Doe';
r.oemName = 'OEMY';
reqs.add(r);

List<Order_GetByCompositeFiltersAction.Response> res = Order_GetByCompositeFiltersAction.run(reqs);

System.debug('### Filtered Orders Output: ' + res[0].result);
