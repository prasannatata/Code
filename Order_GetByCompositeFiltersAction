public class Order_GetByCompositeFiltersAction {
    public class Request {
        @InvocableVariable public String status;
        @InvocableVariable public Date poDateBefore;
        @InvocableVariable public String requestor;
        @InvocableVariable public String oemName;
    }

    public class Response {
        @InvocableVariable public String result;
    }

    @InvocableMethod
    public static List<Response> run(List<Request> requests) {
        List<Response> results = new List<Response>();

        for (Request r : requests) {
            List<String> filters = new List<String>();

            if (!String.isBlank(r.status)) {
                filters.add('OrderStatus__c = \'' + String.escapeSingleQuotes(r.status) + '\'');
            }
            if (r.poDateBefore != null) {
                filters.add('OrderPODate__c < :r.poDateBefore');
            }
            if (!String.isBlank(r.requestor)) {
                filters.add('Requestor__c = \'' + String.escapeSingleQuotes(r.requestor) + '\'');
            }
            if (!String.isBlank(r.oemName)) {
                filters.add('OEM__c = \'' + String.escapeSingleQuotes(r.oemName) + '\'');
            }

            String baseQuery = OrderDL_Util.buildBaseQuery();
            if (!filters.isEmpty()) {
                baseQuery += 'WHERE ' + String.join(filters, ' AND ');
            }

            List<Realistic_OrderLine_Datacsv__dlm> rows = Database.query(baseQuery);

            Response res = new Response();
            res.result = rows.isEmpty() ?
                '❌ No matching orders found with given filters.' :
                OrderDL_Util.fmtOrdersTable(rows, 'Filtered Orders');
            results.add(res);
        }
        return results;
    }
}

