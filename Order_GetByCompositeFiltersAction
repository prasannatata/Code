public with sharing class Order_GetByCompositeFilterAction {

    public class Request {
        @InvocableVariable(label='Order Status (e.g., Pending)')
        public String status;

        @InvocableVariable(label='PO Date Before (yyyy-MM-dd)')
        public Date poDateBefore;

        @InvocableVariable(label='Requestor (optional)')
        public String requestor;

        @InvocableVariable(label='OEM (optional)')
        public String oemName;
    }

    public class Response {
        @InvocableVariable(label='Result')
        public String result;
    }

    @InvocableMethod(label='Get Orders By Composite Filters')
    public static List<Response> run(List<Request> reqs) {
        List<Response> results = new List<Response>();

        for (Request r : reqs) {
            Response res = new Response();

            // --- Base Query ---
            String baseQuery = 'SELECT OrderRefNumber__c, CustomerName__c, OrderStatus__c, ' +
                               'OrderPODate__c, Requestor__c, OEM__c, Vendor__c, ' +
                               'Modality__c, Quantity__c, Revenue__c ' +
                               'FROM Realistic_OrderLine_Datacsv__dlm';

            // --- Build WHERE filters dynamically ---
            List<String> filters = new List<String>();

            if (!String.isBlank(r.status)) {
                filters.add('OrderStatus__c = \'' + String.escapeSingleQuotes(r.status) + '\'');
            }
            if (r.poDateBefore != null) {
                filters.add('OrderPODate__c < ' + r.poDateBefore.formatGmt('yyyy-MM-dd'));
            }
            if (!String.isBlank(r.requestor)) {
                filters.add('Requestor__c = \'' + String.escapeSingleQuotes(r.requestor) + '\'');
            }
            if (!String.isBlank(r.oemName)) {
                filters.add('OEM__c = \'' + String.escapeSingleQuotes(r.oemName) + '\'');
            }

            if (!filters.isEmpty()) {
                baseQuery += ' WHERE ' + String.join(filters, ' AND ');
            }

            // --- Run Query ---
            List<Realistic_OrderLine_Datacsv__dlm> rows = Database.query(baseQuery);

            if (rows.isEmpty()) {
                res.result = '❌ No matching orders found with given filters.';
            } else {
                res.result = OrderDL_Util.fmtOrdersTable(rows, 'Filtered Orders');
            }

            results.add(res);
        }

        return results;
    }
}



