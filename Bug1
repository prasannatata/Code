public with sharing class Customer_TopRevenueAdvancedAction {
    
    public class Request {
        @InvocableVariable public Integer limitSize;
        @InvocableVariable public Integer year;
        @InvocableVariable public Integer quarter;
        @InvocableVariable public String vendor;
        @InvocableVariable public String modality;
        @InvocableVariable public String orderStatus;
    }
    
    public class Response {
        @InvocableVariable public String customerName;
        @InvocableVariable public Integer orderCount;
        @InvocableVariable public Decimal totalRevenue;
        @InvocableVariable public String summary;
    }
    
    @InvocableMethod(label='Top Revenue Customers')
    public static List<Response> run(List<Request> reqs) {
        Request req = (reqs != null && !reqs.isEmpty()) ? reqs[0] : new Request();
        Integer limitValue = (req.limitSize != null && req.limitSize > 0) ? req.limitSize : 5;
        
        String baseQuery = 'SELECT CustomerName__c custName, COUNT(Id) orderCount, SUM(Revenue__c) totalRevenue ' +
                           'FROM Realistic_OrderLine_Datacsv__dlm ';
        
        List<String> filters = new List<String>();
        
        // Handle Year + Quarter with proper date ranges
        if (req.year != null) {
            if (req.quarter != null && req.quarter >= 1 && req.quarter <= 4) {
                Integer startMonth = ((req.quarter - 1) * 3) + 1;
                Integer endMonth   = startMonth + 2;
                Date startOfQuarter = Date.newInstance(req.year, startMonth, 1);
                Date endOfQuarter   = Date.newInstance(req.year, endMonth, Date.daysInMonth(req.year, endMonth));
                
                filters.add('OrderCreateDate__c >= ' + String.valueOf(startOfQuarter) +
                            ' AND OrderCreateDate__c <= ' + String.valueOf(endOfQuarter));
            } else {
                Date startOfYear = Date.newInstance(req.year, 1, 1);
                Date endOfYear   = Date.newInstance(req.year, 12, 31);
                
                filters.add('OrderCreateDate__c >= ' + String.valueOf(startOfYear) +
                            ' AND OrderCreateDate__c <= ' + String.valueOf(endOfYear));
            }
        }
        
        // Optional filters with SQL injection protection
        if (String.isNotBlank(req.vendor)) {
            filters.add('Vendor__c = \'' + String.escapeSingleQuotes(req.vendor) + '\'');
        }
        if (String.isNotBlank(req.modality)) {
            filters.add('Modality__c = \'' + String.escapeSingleQuotes(req.modality) + '\'');
        }
        if (String.isNotBlank(req.orderStatus)) {
            filters.add('OrderStatus__c = \'' + String.escapeSingleQuotes(req.orderStatus) + '\'');
        }
        
        if (!filters.isEmpty()) {
            baseQuery += 'WHERE ' + String.join(filters, ' AND ') + ' ';
        }
        
        baseQuery += 'GROUP BY CustomerName__c ORDER BY SUM(Revenue__c) DESC LIMIT ' + limitValue;
        
        System.debug('Final SOQL: ' + baseQuery);
        
        List<AggregateResult> rows;
        try {
            rows = Database.query(baseQuery);
        } catch (QueryException e) {
            System.debug('Query Error: ' + e.getMessage());
            Response errorRes = new Response();
            errorRes.summary = '❌ Error executing query: ' + e.getMessage();
            return new List<Response>{ errorRes };
        }
        
        List<Response> results = new List<Response>();
        
        for (AggregateResult ar : rows) {
            Response r = new Response();
            r.customerName = (String) ar.get('custName');
            
            // Handle potential Long to Integer conversion safely
            Object countObj = ar.get('orderCount');
            r.orderCount = (countObj != null) ? Integer.valueOf(countObj) : 0;
            
            // Handle null revenue safely
            Object revenueObj = ar.get('totalRevenue');
            r.totalRevenue = (revenueObj != null) ? (Decimal) revenueObj : 0;
            
            // Format summary with proper null handling
            r.summary = '📊 ' + r.customerName + ' generated $' + 
                        r.totalRevenue.setScale(2) + ' from ' + r.orderCount + ' orders.';
            
            results.add(r);
        }
        
        if (results.isEmpty()) {
            Response emptyRes = new Response();
            emptyRes.summary = '⚠️ No customers found for the given filters.';
            results.add(emptyRes);
        }
        
        return results;
    }
}






