## 🔹 1. Apex Invocable Method

```apex
public with sharing class RevenueDropOffController {

    @InvocableMethod(
        label='Detect Revenue Drop-Off'
        description='Compares customer revenue across two periods and returns drop-off details'
    )
    public static List<Response> detectDropOff(List<Request> reqList) {
        List<Response> responses = new List<Response>();

        if (reqList.isEmpty()) return responses;

        Request req = reqList[0];

        // Dummy SOQL for illustration — replace with your actual revenue object
        List<AggregateResult> results = [
            SELECT Account.Name customerName,
                   SUM(Amount) amount
            FROM Opportunity
            WHERE CloseDate >= :req.period1Start AND CloseDate <= :req.period1End
            GROUP BY Account.Name
        ];

        List<DropOffWrapper> wrappers = new List<DropOffWrapper>();

        for (AggregateResult ar : results) {
            DropOffWrapper w = new DropOffWrapper();
            w.customerName   = (String)ar.get('customerName');
            w.period1Revenue = String.valueOf(ar.get('amount'));
            w.period2Revenue = '0'; // TODO: replace with actual period2 query logic
            w.dropAmount     = '0'; // TODO: calculate difference
            w.dropPercentage = '0%'; // TODO: calculate %
            wrappers.add(w);
        }

        Response resp = new Response();
        resp.dropOffResults = wrappers;
        responses.add(resp);

        return responses;
    }

    public class Request {
        @InvocableVariable(label='Period 1 Start Date')
        public Date period1Start;

        @InvocableVariable(label='Period 1 End Date')
        public Date period1End;

        @InvocableVariable(label='Period 2 Start Date')
        public Date period2Start;

        @InvocableVariable(label='Period 2 End Date')
        public Date period2End;

        @InvocableVariable(label='Top N Customers')
        public Integer topN;
    }

    public class Response {
        @InvocableVariable
        public List<DropOffWrapper> dropOffResults;
    }

    public class DropOffWrapper {
        @InvocableVariable public String customerName;
        @InvocableVariable public String period1Revenue;
        @InvocableVariable public String period2Revenue;
        @InvocableVariable public String dropAmount;
        @InvocableVariable public String dropPercentage;
    }
}
```

